{
    "title": "SCE 1.8 Reactive Probe: Stop Malicious Build (Attack 1.7)",
    "description": "Validates that a reactive control (EventBridge rule triggering a Lambda function) detects and stops an unauthorized/malicious CodeBuild build. The attack simulates starting a malicious build (attack node 1.7), and the reactive probe verifies that the build is automatically stopped by the defensive control.",
    "tags": [
        "sce-1.8",
        "reactive",
        "codebuild",
        "malicious-build",
        "eventbridge",
        "lambda",
        "security-chaos-engineering"
    ],
    "steady-state-hypothesis": {
        "title": "Malicious build should be reactively stopped by the EventBridge-Lambda control",
        "probes": [
            {
                "type": "probe",
                "name": "verify-malicious-build-was-stopped",
                "tolerance": true,
                "provider": {
                    "type": "python",
                    "module": "chaosaws.ec2.1_8_sce_experiment_reactive",
                    "func": "hypothesis_verification"
                }
            }
        ]
    },
    "method": [
        {
            "type": "action",
            "name": "deploy-codebuild-project-with-reactive-controls",
            "provider": {
                "type": "python",
                "module": "chaosaws.ec2.1_8_sce_experiment_reactive",
                "func": "steady_state"
            }
        },
        {
            "type": "action",
            "name": "start-malicious-codebuild-build",
            "provider": {
                "type": "python",
                "module": "chaosaws.ec2.1_8_sce_experiment_reactive",
                "func": "attack"
            }
        }
    ],
    "rollbacks": [
        {
            "type": "action",
            "name": "delete-cloudformation-stack-and-all-resources",
            "provider": {
                "type": "python",
                "module": "chaosaws.ec2.1_8_sce_experiment_reactive",
                "func": "rollback"
            }
        }
    ]
