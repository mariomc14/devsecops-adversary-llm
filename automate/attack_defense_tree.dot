digraph AttackDefenseTree {
    graph [
        fontname="Arial",
        splines=ortho,
        nodesep=0.6,
        ranksep=0.85,
        rankdir=TB,
        ordering="out",
        compound=true,
        label=<<b>Attack-Defense Tree: EC2 IMDS Protection Weakening</b><br/><i>Cloud-Native Banking Platform - DevSecOps Security Analysis</i>>,
        labelloc="t",
        fontsize=16
    ];
    node [fontname="Arial"];

    // ============================================================
    // ROOT NODE
    // ============================================================
    "Root" [
        label=<<b>0.0 Root: Banking Platform Entry Point</b><br/><br/><b>Mission:</b> Secure cloud-native banking platform<br/><b>Tech Stack:</b> EC2 + Containers + CodeBuild<br/><b>Threat Actor:</b> Compromised developer credentials<br/><b>Target:</b> Transaction microservices EC2 instances>>,
        shape=rectangle, style="filled,bold", fillcolor="#C6E8D1", fontcolor="black", margin="0.3"
    ];

    // ============================================================
    // ATTACK STEP 1: WEAKEN IMDS CONFIGURATION
    // ============================================================
    
    "1.1-Preventive-IAM" [
        shape=rectangle, style="filled,rounded", fillcolor="#0683FF", fontcolor="white",
        label=<<b>1.1 IAM Policy Restriction</b><br/><br/><b>Classification:</b> Preventive<br/><b>Description:</b> Deny ec2:ModifyInstanceMetadataOptions<br/>permission except for authorized IaC automation<br/>roles with MFA and approval workflows.<br/><b>Implementation:</b> IAM policy boundary +<br/>explicit deny statements>>, margin="0.25"
    ];

    "1.2-Preventive-SCP" [
        shape=rectangle, style="filled,rounded", fillcolor="#0683FF", fontcolor="white",
        label=<<b>1.2 SCP Guardrail</b><br/><br/><b>Classification:</b> Preventive<br/><b>Description:</b> Organization-level Service Control<br/>Policy preventing IMDS weakening across all<br/>banking workload accounts.<br/><b>Implementation:</b> AWS Organizations SCP<br/>with condition keys for HttpTokens>>, margin="0.25"
    ];

    "1.3-Attack" [
        shape=rectangle, style="filled,bold", fillcolor="#F40B0B", fontcolor="white",
        label=<<b>1.3 Weaken IMDS Security Configuration</b><br/><br/><b>Command:</b><br/>aws ec2 modify-instance-metadata-options \<br/>  --instance-id i-0abc123def456 \<br/>  --http-tokens optional \<br/>  --http-endpoint enabled \<br/>  --http-put-response-hop-limit 2<br/><br/><b>Dependencies:</b><br/>• ec2:ModifyInstanceMetadataOptions permission<br/>• Valid AWS credentials (compromised dev account)<br/>• Target EC2 instance ID (transaction-svc-prod-01)<br/>• Instance in running/stopped state<br/><br/><b>Result:</b> IMDSv1 enabled, hop limit increased to 2,<br/>allowing container access to metadata endpoint<br/><br/><b>TTP:</b> T1562.001 - Impair Defenses: Disable or Modify Tools>>, margin="0.3"
    ];

    "1.4-Chaos" [
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", fontcolor="black",
        label=<<b>1.4 SCE Experiment: IMDS Modification</b><br/><br/><b>Preventive Probe:</b> Attempt ModifyInstanceMetadataOptions<br/>with test credentials lacking permission - verify<br/>AccessDenied response within 100ms<br/><br/><b>Detective Probe:</b> Execute authorized modification,<br/>verify CloudTrail event appears in SIEM within<br/>30 seconds with correct severity classification<br/><br/><b>Reactive Probe:</b> Trigger unauthorized modification,<br/>verify auto-remediation Lambda reverts settings<br/>within 60 seconds and alerts SOC>>, margin="0.25"
    ];

    "1.5-Detective-CloudTrail" [
        shape=rectangle, style="filled,rounded", fillcolor="#0683FF", fontcolor="white",
        label=<<b>1.5 CloudTrail API Monitoring</b><br/><br/><b>Classification:</b> Detective<br/><b>Description:</b> Real-time alerting on<br/>ModifyInstanceMetadataOptions API calls<br/>with correlation to user identity and<br/>source IP geolocation.<br/><b>Implementation:</b> EventBridge rule +<br/>Security Hub finding + PagerDuty alert>>, margin="0.25"
    ];

    "1.6-Detective-Config" [
        shape=rectangle, style="filled,rounded", fillcolor="#0683FF", fontcolor="white",
        label=<<b>1.6 AWS Config Compliance Rule</b><br/><br/><b>Classification:</b> Detective<br/><b>Description:</b> Continuous compliance monitoring<br/>for ec2-imdsv2-check managed rule ensuring<br/>all banking EC2 instances enforce IMDSv2.<br/><b>Implementation:</b> AWS Config rule with<br/>automated compliance dashboard>>, margin="0.25"
    ];

    "1.7-Reactive-Lambda" [
        shape=rectangle, style="filled,rounded", fillcolor="#0683FF", fontcolor="white",
        label=<<b>1.7 Auto-Remediation Lambda</b><br/><br/><b>Classification:</b> Reactive<br/><b>Description:</b> Automatically revert IMDS<br/>configuration to secure state (HttpTokens=required,<br/>HopLimit=1) upon detection of unauthorized change.<br/><b>Implementation:</b> EventBridge trigger +<br/>Lambda function + SNS notification>>, margin="0.25"
    ];

    // ============================================================
    // ATTACK STEP 2: ACCESS IMDS FROM CONTAINER
    // ============================================================

    "2.1-Preventive-Network" [
        shape=rectangle, style="filled,rounded", fillcolor="#0683FF", fontcolor="white",
        label=<<b>2.1 Network Policy Enforcement</b><br/><br/><b>Classification:</b> Preventive<br/><b>Description:</b> iptables rules and container<br/>network policies blocking egress to<br/>169.254.169.254 from container namespaces.<br/><b>Implementation:</b> Host iptables +<br/>Kubernetes NetworkPolicy + Calico rules>>, margin="0.25"
    ];

    "2.2-Preventive-Runtime" [
        shape=rectangle, style="filled,rounded", fillcolor="#0683FF", fontcolor="white",
        label=<<b>2.2 Container Runtime Hardening</b><br/><br/><b>Classification:</b> Preventive<br/><b>Description:</b> Drop NET_RAW capability,<br/>enforce AppArmor/SELinux profiles preventing<br/>network enumeration and metadata access.<br/><b>Implementation:</b> securityContext in<br/>pod specs + mandatory MAC policies>>, margin="0.25"
    ];

    "2.3-Attack" [
        shape=rectangle, style="filled,bold", fillcolor="#F40B0B", fontcolor="white",
        label=<<b>2.3 Access IMDS from Container</b><br/><br/><b>Command:</b><br/>curl http://169.254.169.254/latest/meta-data/<br/>  iam/security-credentials/BankingTransactionRole<br/><br/><b>Dependencies:</b><br/>• Access to container on target EC2 instance<br/>• IMDS weakened (HopLimit &gt; 1)<br/>• Network path to metadata endpoint available<br/>• IAM role name enumerable or known<br/><br/><b>Result:</b> Temporary IAM credentials retrieved:<br/>AccessKeyId, SecretAccessKey, SessionToken<br/>for BankingTransactionRole with S3/RDS access<br/><br/><b>TTP:</b> T1552.005 - Unsecured Credentials:<br/>Cloud Instance Metadata API>>, margin="0.3"
    ];

    "2.4-Chaos" [
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", fontcolor="black",
        label=<<b>2.4 SCE Experiment: Metadata Access</b><br/><br/><b>Preventive Probe:</b> From test container, attempt<br/>curl to 169.254.169.254 - verify connection<br/>blocked by iptables (REJECT/timeout)<br/><br/><b>Detective Probe:</b> Bypass network control in<br/>test environment, verify Falco alert fires<br/>within 5 seconds with container context<br/><br/><b>Reactive Probe:</b> Trigger metadata access alert,<br/>verify container terminated and replacement<br/>spawned within 30 seconds>>, margin="0.25"
    ];

    "2.5-Detective-FlowLogs" [
        shape=rectangle, style="filled,rounded", fillcolor="#0683FF", fontcolor="white",
        label=<<b>2.5 VPC Flow Log Analysis</b><br/><br/><b>Classification:</b> Detective<br/><b>Description:</b> Monitor network flows to<br/>169.254.169.254 from unexpected ENIs or<br/>container network interfaces.<br/><b>Implementation:</b> VPC Flow Logs +<br/>Athena queries + CloudWatch anomaly detection>>, margin="0.25"
    ];

    "2.6-Detective-Falco" [
        shape=rectangle, style="filled,rounded", fillcolor="#0683FF", fontcolor="white",
        label=<<b>2.6 Runtime Security Monitoring (Falco)</b><br/><br/><b>Classification:</b> Detective<br/><b>Description:</b> Real-time detection of curl/wget<br/>processes accessing metadata IP from container<br/>context with full process tree capture.<br/><b>Implementation:</b> Falco rules +<br/>CloudWatch Logs + SIEM integration>>, margin="0.25"
    ];

    "2.7-Reactive-Quarantine" [
        shape=rectangle, style="filled,rounded", fillcolor="#0683FF", fontcolor="white",
        label=<<b>2.7 Container Isolation &amp; Quarantine</b><br/><br/><b>Classification:</b> Reactive<br/><b>Description:</b> Automatically terminate and<br/>quarantine suspicious container, capture<br/>forensic state, scale replacement instance.<br/><b>Implementation:</b> Falco response action +<br/>container runtime API + forensic snapshot>>, margin="0.25"
    ];

    // ============================================================
    // ATTACK STEP 3: LATERAL MOVEMENT WITH STOLEN CREDENTIALS
    // ============================================================

    "3.1-Preventive-Conditions" [
        shape=rectangle, style="filled,rounded", fillcolor="#0683FF", fontcolor="white",
        label=<<b>3.1 IAM Condition Key Restrictions</b><br/><br/><b>Classification:</b> Preventive<br/><b>Description:</b> Restrict IAM role assumption<br/>to specific VPC, instance ID, and source IP<br/>ranges using aws:SourceVpc and aws:SourceIp.<br/><b>Implementation:</b> IAM trust policy with<br/>condition blocks for network context>>, margin="0.25"
    ];

    "3.2-Preventive-LeastPriv" [
        shape=rectangle, style="filled,rounded", fillcolor="#0683FF", fontcolor="white",
        label=<<b>3.2 Least Privilege Role Scoping</b><br/><br/><b>Classification:</b> Preventive<br/><b>Description:</b> Minimize EC2 instance role<br/>permissions to only required actions with<br/>resource-level restrictions for banking data.<br/><b>Implementation:</b> Fine-grained IAM policies<br/>with explicit resource ARNs>>, margin="0.25"
    ];

    "3.3-Attack" [
        shape=rectangle, style="filled,bold", fillcolor="#F40B0B", fontcolor="white",
        label=<<b>3.3 Lateral Movement with Stolen Credentials</b><br/><br/><b>Command:</b><br/>export AWS_ACCESS_KEY_ID=ASIA...<br/>export AWS_SECRET_ACCESS_KEY=...<br/>export AWS_SESSION_TOKEN=...<br/>aws sts get-caller-identity<br/>aws s3 ls s3://banking-transactions-prod/<br/>aws secretsmanager get-secret-value \<br/>  --secret-id prod/db/credentials<br/><br/><b>Dependencies:</b><br/>• Exfiltrated temporary credentials from Step 2<br/>• AWS CLI on attacker system<br/>• Network access to AWS APIs (internet/VPN)<br/><br/><b>Result:</b> Attacker operating as BankingTransactionRole,<br/>accessing S3 transaction data, RDS credentials,<br/>and Secrets Manager entries<br/><br/><b>TTP:</b> T1078.004 - Valid Accounts: Cloud Accounts>>, margin="0.3"
    ];

    "3.4-Chaos" [
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", fontcolor="black",
        label=<<b>3.4 SCE Experiment: Credential Abuse</b><br/><br/><b>Preventive Probe:</b> Use valid instance credentials<br/>from external IP - verify AccessDenied due to<br/>VPC source condition within 100ms<br/><br/><b>Detective Probe:</b> Simulate anomalous credential<br/>use pattern, verify GuardDuty finding generated<br/>within 5 minutes with HIGH severity<br/><br/><b>Reactive Probe:</b> Trigger credential abuse alert,<br/>verify automatic session revocation completes<br/>within 2 minutes and SOC notified>>, margin="0.25"
    ];

    "3.5-Detective-GuardDuty" [
        shape=rectangle, style="filled,rounded", fillcolor="#0683FF", fontcolor="white",
        label=<<b>3.5 GuardDuty Credential Anomaly Detection</b><br/><br/><b>Classification:</b> Detective<br/><b>Description:</b> Detect instance credential use<br/>from anomalous locations, IPs, or user agents<br/>indicating credential theft and exfiltration.<br/><b>Implementation:</b> GuardDuty + Security Hub +<br/>automated finding enrichment>>, margin="0.25"
    ];

    "3.6-Detective-SIEM" [
        shape=rectangle, style="filled,rounded", fillcolor="#0683FF", fontcolor="white",
        label=<<b>3.6 CloudTrail + SIEM Correlation</b><br/><br/><b>Classification:</b> Detective<br/><b>Description:</b> Correlate API calls with expected<br/>instance behavior patterns, detect impossible<br/>travel and concurrent session anomalies.<br/><b>Implementation:</b> CloudTrail + Splunk/Elastic<br/>correlation rules + ML baseline>>, margin="0.25"
    ];

    "3.7-Reactive-Revoke" [
        shape=rectangle, style="filled,rounded", fillcolor="#0683FF", fontcolor="white",
        label=<<b>3.7 Automatic Credential Revocation</b><br/><br/><b>Classification:</b> Reactive<br/><b>Description:</b> Invalidate all active sessions<br/>for compromised role, rotate instance profile,<br/>and trigger credential refresh across fleet.<br/><b>Implementation:</b> Lambda + IAM API +<br/>SSM for instance credential rotation>>, margin="0.25"
    ];

    "3.8-Reactive-IR" [
        shape=rectangle, style="filled,rounded", fillcolor="#0683FF", fontcolor="white",
        label=<<b>3.8 Incident Response Workflow</b><br/><br/><b>Classification:</b> Reactive<br/><b>Description:</b> Trigger full incident response<br/>including forensic capture, SOC notification,<br/>timeline reconstruction, and evidence preservation.<br/><b>Implementation:</b> Step Functions workflow +<br/>PagerDuty + Forensic S3 bucket>>, margin="0.25"
    ];

    // ============================================================
    // FINAL NODE - STRIDE GOALS
    // ============================================================

    "Final" [
        label=<<b>4.0 Attack Goal: Banking Platform Compromise</b><br/><br/><b>STRIDE Classification:</b><br/>• <b>Tampering:</b> IMDS configuration modified<br/>• <b>Information Disclosure:</b> IAM credentials exfiltrated<br/>• <b>Elevation of Privilege:</b> Attacker assumes instance role<br/><br/><b>Business Impact:</b><br/>• Unauthorized access to transaction data<br/>• Potential financial fraud capability<br/>• PCI-DSS compliance violation<br/>• Regulatory notification requirements>>,
        shape=rectangle, style="filled,bold", fillcolor="#C6E8D1", fontcolor="black", margin="0.3"
    ];

    // ============================================================
    // RANK ALIGNMENT
    // ============================================================
    
    {rank=same; "1.1-Preventive-IAM"; "1.2-Preventive-SCP"}
    {rank=same; "1.3-Attack"; "1.4-Chaos"}
    {rank=same; "1.5-Detective-CloudTrail"; "1.6-Detective-Config"; "1.7-Reactive-Lambda"}
    {rank=same; "2.1-Preventive-Network"; "2.2-Preventive-Runtime"}
    {rank=same; "2.3-Attack"; "2.4-Chaos"}
    {rank=same; "2.5-Detective-FlowLogs"; "2.6-Detective-Falco"; "2.7-Reactive-Quarantine"}
    {rank=same; "3.1-Preventive-Conditions"; "3.2-Preventive-LeastPriv"}
    {rank=same; "3.3-Attack"; "3.4-Chaos"}
    {rank=same; "3.5-Detective-GuardDuty"; "3.6-Detective-SIEM"}
    {rank=same; "3.7-Reactive-Revoke"; "3.8-Reactive-IR"}

    // ============================================================
    // MAIN FLOW CONNECTIONS
    // ============================================================

    // Root to Step 1 Preventive
    "Root" -> "1.1-Preventive-IAM" [penwidth=2];
    "Root" -> "1.2-Preventive-SCP" [penwidth=2];

    // Step 1 Preventive to Attack
    "1.1-Preventive-IAM" -> "1.3-Attack" [penwidth=2, label="  bypassed  ", fontsize=9];
    "1.2-Preventive-SCP" -> "1.3-Attack" [penwidth=2, label="  bypassed  ", fontsize=9];

    // Step 1 Attack to Detective/Reactive
    "1.3-Attack" -> "1.5-Detective-CloudTrail" [penwidth=2];
    "1.3-Attack" -> "1.6-Detective-Config" [penwidth=2];
    "1.3-Attack" -> "1.7-Reactive-Lambda" [penwidth=2];

    // Step 1 to Step 2 Preventive
    "1.5-Detective-CloudTrail" -> "2.1-Preventive-Network" [penwidth=2];
    "1.6-Detective-Config" -> "2.1-Preventive-Network" [penwidth=2];
    "1.7-Reactive-Lambda" -> "2.1-Preventive-Network" [penwidth=2, style=dashed, label="  if not remediated  ", fontsize=9];
    "1.5-Detective-CloudTrail" -> "2.2-Preventive-Runtime" [penwidth=2];
    "1.6-Detective-Config" -> "2.2-Preventive-Runtime" [penwidth=2];
    "1.7-Reactive-Lambda" -> "2.2-Preventive-Runtime" [penwidth=2, style=dashed];

    // Step 2 Preventive to Attack
    "2.1-Preventive-Network" -> "2.3-Attack" [penwidth=2, label="  bypassed  ", fontsize=9];
    "2.2-Preventive-Runtime" -> "2.3-Attack" [penwidth=2, label="  bypassed  ", fontsize=9];

    // Step 2 Attack to Detective/Reactive
    "2.3-Attack" -> "2.5-Detective-FlowLogs" [penwidth=2];
    "2.3-Attack" -> "2.6-Detective-Falco" [penwidth=2];
    "2.3-Attack" -> "2.7-Reactive-Quarantine" [penwidth=2];

    // Step 2 to Step 3 Preventive
    "2.5-Detective-FlowLogs" -> "3.1-Preventive-Conditions" [penwidth=2];
    "2.6-Detective-Falco" -> "3.1-Preventive-Conditions" [penwidth=2];
    "2.7-Reactive-Quarantine" -> "3.1-Preventive-Conditions" [penwidth=2, style=dashed, label="  if escaped  ", fontsize=9];
    "2.5-Detective-FlowLogs" -> "3.2-Preventive-LeastPriv" [penwidth=2];
    "2.6-Detective-Falco" -> "3.2-Preventive-LeastPriv" [penwidth=2];
    "2.7-Reactive-Quarantine" -> "3.2-Preventive-LeastPriv" [penwidth=2, style=dashed];

    // Step 3 Preventive to Attack
    "3.1-Preventive-Conditions" -> "3.3-Attack" [penwidth=2, label="  bypassed  ", fontsize=9];
    "3.2-Preventive-LeastPriv" -> "3.3-Attack" [penwidth=2, label="  bypassed  ", fontsize=9];

    // Step 3 Attack to Detective/Reactive
    "3.3-Attack" -> "3.5-Detective-GuardDuty" [penwidth=2];
    "3.3-Attack" -> "3.6-Detective-SIEM" [penwidth=2];
    "3.3-Attack" -> "3.7-Reactive-Revoke" [penwidth=2];
    "3.3-Attack" -> "3.8-Reactive-IR" [penwidth=2];

    // Step 3 Detective/Reactive to Final
    "3.5-Detective-GuardDuty" -> "Final" [penwidth=2];
    "3.6-Detective-SIEM" -> "Final" [penwidth=2];
    "3.7-Reactive-Revoke" -> "Final" [penwidth=2];
    "3.8-Reactive-IR" -> "Final" [penwidth=2];

    // ============================================================
    // CHAOS NODE CONNECTIONS (Dashed Orange)
    // ============================================================

    "1.3-Attack" -> "1.4-Chaos" [style=dashed, color="#FC8600", penwidth=2];
    "2.3-Attack" -> "2.4-Chaos" [style=dashed, color="#FC8600", penwidth=2];
    "3.3-Attack" -> "3.4-Chaos" [style=dashed, color="#FC8600", penwidth=2];

    // ============================================================
    // LEGEND SUBGRAPH
    // ============================================================

    subgraph cluster_legend {
        label=<<b>Legend</b>>;
        labelloc="t";
        fontsize=12;
        style="rounded,dashed";
        color="#666666";
        
        "leg_root" [
            shape=rectangle, style=filled, fillcolor="#C6E8D1", fontcolor="black",
            label=<<b>Root/Final Node</b><br/>Entry &amp; Goal Points>>, margin="0.15"
        ];
        "leg_attack" [
            shape=rectangle, style=filled, fillcolor="#F40B0B", fontcolor="white",
            label=<<b>Attack Step</b><br/>Adversary Action>>, margin="0.15"
        ];
        "leg_safeguard" [
            shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white",
            label=<<b>Safeguard</b><br/>Preventive/Detective/Reactive>>, margin="0.15"
        ];
        "leg_chaos" [
            shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", fontcolor="black",
            label=<<b>SCE Experiment</b><br/>Security Chaos Engineering>>, margin="0.15"
        ];

        "leg_root" -> "leg_attack" [style=invis];
        "leg_attack" -> "leg_safeguard" [style=invis];
        "leg_safeguard" -> "leg_chaos" [style=invis];
    }
}