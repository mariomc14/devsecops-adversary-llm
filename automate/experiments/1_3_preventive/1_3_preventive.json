{
    "title": "SCE Experiment 1.3: Preventive Probe - EC2 Reconnaissance Prevention",
    "description": "Validates that least-privilege IAM permission boundaries prevent unauthorized EC2 reconnaissance attacks (T1580 - Cloud Infrastructure Discovery). The experiment deploys a permission boundary that explicitly denies ec2:DescribeInstances and attaches it to a simulated CI/CD role. The attack simulation attempts to enumerate EC2 instances, which should be blocked with AccessDenied.",
    "tags": [
        "sce-node:1.3",
        "probe-type:preventive",
        "attack-node:1.2",
        "ttp:T1580",
        "aws:ec2",
        "aws:iam"
    ],
    "steady-state-hypothesis": {
        "title": "Least-privilege IAM permission boundary blocks EC2 reconnaissance",
        "probes": [
            {
                "type": "probe",
                "name": "verify-preventive-control-blocks-reconnaissance",
                "tolerance": true,
                "provider": {
                    "type": "python",
                    "module": "chaosaws.ec2.1_3_preventive",
                    "func": "hypothesis_verification"
                }
            }
        ]
    },
    "method": [
        {
            "type": "action",
            "name": "deploy-preventive-control-infrastructure",
            "provider": {
                "type": "python",
                "module": "chaosaws.ec2.1_3_preventive",
                "func": "steady_state"
            }
        },
        {
            "type": "action",
            "name": "execute-ec2-reconnaissance-attack",
            "provider": {
                "type": "python",
                "module": "chaosaws.ec2.1_3_preventive",
                "func": "attack"
            }
        }
    ],
    "rollbacks": [
        {
            "type": "action",
            "name": "cleanup-experiment-resources",
            "provider": {
                "type": "python",
                "module": "chaosaws.ec2.1_3_preventive",
                "func": "rollback"
            }
        }
    ]
}