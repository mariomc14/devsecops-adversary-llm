                "type": "probe",
                "name": "verify-detective-control-detected-malicious-project",
                "tolerance": true,
                "provider": {
                    "type": "python",
                    "module": "chaosaws.ec2.1_3_sce_experiment_detective",
                    "func": "hypothesis_verification"
                }
            }
        ]
    },
