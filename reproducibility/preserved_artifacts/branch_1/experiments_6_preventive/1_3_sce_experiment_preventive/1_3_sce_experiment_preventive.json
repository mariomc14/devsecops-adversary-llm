{
    "title": "SCE 1.3 Preventive: Block Malicious CodeBuild Project Creation",
    "description": "Validates that a preventive IAM deny policy blocks the creation of unauthorized CodeBuild projects (Attack Node 1.2). The experiment deploys a role with an explicit Deny on codebuild:CreateProject, then attempts to create a malicious project using that role. The hypothesis is that the API call is denied, proving the preventive control is effective.",
    "tags": [
        "sce-1.3",
        "preventive",
        "codebuild",
        "iam-deny",
        "security-chaos-engineering"
    ],
    "steady-state-hypothesis": {
        "title": "Malicious CodeBuild project creation is blocked by preventive IAM deny policy",
        "probes": [
            {
                "type": "probe",
                "name": "verify-preventive-control-blocks-codebuild-create-project",
                "tolerance": true,
                "provider": {
                    "type": "python",
                    "module": "chaosaws.ec2.1_3_sce_experiment_preventive",
                    "func": "hypothesis_verification"
                }
            }
        ]
    },
    "method": [
        {
            "type": "action",
            "name": "deploy-experiment-infrastructure-with-preventive-deny-policy",
            "provider": {
                "type": "python",
                "module": "chaosaws.ec2.1_3_sce_experiment_preventive",
                "func": "steady_state"
            }
        },
        {
            "type": "action",
            "name": "attempt-malicious-codebuild-project-creation",
            "provider": {
                "type": "python",
                "module": "chaosaws.ec2.1_3_sce_experiment_preventive",
                "func": "attack"
            }
        }
    ],
    "rollbacks": [
        {
            "type": "action",
            "name": "delete-experiment-cloudformation-stack-and-resources",
            "provider": {
                "type": "python",
                "module": "chaosaws.ec2.1_3_sce_experiment_preventive",
                "func": "rollback"
            }
        }
    ]
}