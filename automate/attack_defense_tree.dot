digraph IMDS_Weakening_Attack_Defense_Tree {
    graph [
        fontname="Arial",
        splines=ortho,
        nodesep=0.6,
        ranksep=1.0,
        rankdir=TB,
        ordering="out",
        compound=true,
        bgcolor="white"
    ];
    node [fontname="Arial", margin=0.15];
    edge [fontname="Arial"];

    // ============================================================================
    // ROOT AND FINAL NODES
    // ============================================================================
    
    "Root" [
        label=<
            <b>ATTACK ROOT:</b><br/>
            <b>EC2 IMDS Credential Exfiltration</b><br/>
            <i>Goal: Steal temporary AWS credentials via metadata service weakening</i>
        >,
        shape=rectangle, style="filled,bold", fillcolor="#C6E8D1", fontcolor="black"
    ];

    "Final" [
        label=<
            <b>FINAL GOAL (STRIDE):</b><br/>
            <b>Elevation of Privilege / Information Disclosure / Tampering</b><br/>
            <b>Attacker obtains credentials; achieves privilege escalation &amp; lateral movement</b>
        >,
        shape=rectangle, style="filled,bold", fillcolor="#C6E8D1", fontcolor="black"
    ];

    // ============================================================================
    // STEP 1: ENUMERATE TARGET EC2 INSTANCES
    // ============================================================================

    "1-Preventive" [
        label=<
            <b>1.1 | Preventive Safeguard</b><br/>
            <b>IAM Least-Privilege for EC2 Discovery</b><br/>
            <b>Classification:</b> Preventive<br/>
            <b>Description:</b> Restrict ec2:DescribeInstances<br/>
            permission to specific resource tags or instance profiles.<br/>
            Deny wildcard (*) permissions. Require MFA for privilege roles.
        >,
        shape=rectangle, style="filled", fillcolor="#0683FF", fontcolor="white"
    ];

    "1-Attack" [
        label=<
            <b>1.2 | Attack Step 1</b><br/>
            <b>Enumerate Target EC2 Instances</b><br/>
            <b>Command:</b> aws ec2 describe-instances<br/>
            --query &apos;Reservations[*].Instances[?IamInstanceProfile]...&apos;<br/>
            <b>Dependencies:</b> ec2:DescribeInstances permission,<br/>
            target instance with IAM profile<br/>
            <b>Result:</b> Identified EC2 instances with IAM instance profiles.<br/>
            Attacker maps credential targets.<br/>
            <b>TTP:</b> T1526 - Gather System Network Configuration Discovery
        >,
        shape=rectangle, style="filled", fillcolor="#F40B0B", fontcolor="white"
    ];

    "1-SCE-Preventive" [
        label=<
            <b>1.3 | SCE Preventive Probe</b><br/>
            <b>Challenge:</b> Can attacker execute describe-instances<br/>
            without IAM policy?<br/>
            <b>Expected Block:</b> IAM policy denies<br/>
            ec2:DescribeInstances for non-approved principals.<br/>
            Request fails with AccessDenied.
        >,
        shape=rectangle, style="filled,rounded", fillcolor="#FFB84D", fontcolor="black"
    ];

    "1-Detective" [
        label=<
            <b>1.4 | Detective Safeguard</b><br/>
            <b>CloudTrail API Activity Monitoring</b><br/>
            <b>Classification:</b> Detective<br/>
            <b>Description:</b> Monitor CloudTrail for<br/>
            ec2:DescribeInstances calls from unusual principals, IPs, or times.<br/>
            Alert on bulk queries (&gt;10 describe calls/min).
        >,
        shape=rectangle, style="filled", fillcolor="#0683FF", fontcolor="white"
    ];

    "1-SCE-Detective" [
        label=<
            <b>1.5 | SCE Detective Probe</b><br/>
            <b>Challenge:</b> Can detection identify<br/>
            enumeration attempt in real-time?<br/>
            <b>Expected Detection:</b> CloudTrail logs<br/>
            describe-instances within &lt;1 min. SIEM detects<br/>
            anomalous source IP or timing. Alert triggered.
        >,
        shape=rectangle, style="filled,rounded", fillcolor="#FFB84D", fontcolor="black"
    ];

    "1-Reactive" [
        label=<
            <b>1.6 | Reactive Safeguard</b><br/>
            <b>Incident Response - Enum Attempt</b><br/>
            <b>Classification:</b> Reactive<br/>
            <b>Description:</b> Revoke attacker credentials immediately.<br/>
            Terminate sessions. Create incident ticket.<br/>
            Force MFA reset for associated developer account.
        >,
        shape=rectangle, style="filled", fillcolor="#0683FF", fontcolor="white"
    ];

    "1-SCE-Reactive" [
        label=<
            <b>1.7 | SCE Reactive Probe</b><br/>
            <b>Challenge:</b> Can system respond<br/>
            before credentials used for next step?<br/>
            <b>Expected Response:</b> Revoke within &lt;5 min.<br/>
            Verify old credentials rejected. Check for no<br/>
            describe calls after revocation.
        >,
        shape=rectangle, style="filled,rounded", fillcolor="#FFB84D", fontcolor="black"
    ];

    // ============================================================================
    // STEP 2: RETRIEVE CURRENT INSTANCE METADATA OPTIONS
    // ============================================================================

    "2-Preventive" [
        label=<
            <b>1.8 | Preventive Safeguard</b><br/>
            <b>Policy-as-Code: Enforce IMDSv2 Requirement</b><br/>
            <b>Classification:</b> Preventive<br/>
            <b>Description:</b> Use AWS Config or OPA/Rego<br/>
            policy to enforce HttpTokens=required (IMDSv2)<br/>
            on all EC2 instances. Block launch templates<br/>
            with weaker settings. Require infrastructure-as-code review.
        >,
        shape=rectangle, style="filled", fillcolor="#0683FF", fontcolor="white"
    ];

    "2-Attack" [
        label=<
            <b>1.9 | Attack Step 2</b><br/>
            <b>Retrieve Current IMDS Options</b><br/>
            <b>Command:</b> aws ec2 describe-instances<br/>
            --instance-ids &lt;ID&gt; --query &apos;...MetadataOptions&apos;<br/>
            <b>Dependencies:</b> ec2:DescribeInstances,<br/>
            target instance ID<br/>
            <b>Result:</b> Retrieved IMDS baseline config<br/>
            (HttpTokens, HttpPutResponseHopLimit, endpoint state)<br/>
            <b>TTP:</b> T1526 - System Network Discovery
        >,
        shape=rectangle, style="filled", fillcolor="#F40B0B", fontcolor="white"
    ];

    "2-SCE-Preventive" [
        label=<
            <b>1.10 | SCE Preventive Probe</b><br/>
            <b>Challenge:</b> Can attacker retrieve<br/>
            metadata options without policy enforcement?<br/>
            <b>Expected Block:</b> Config compliance rule<br/>
            detects any downgrade to IMDSv1.<br/>
            Automatic remediation reverts to IMDSv2.
        >,
        shape=rectangle, style="filled,rounded", fillcolor="#FFB84D", fontcolor="black"
    ];

    "2-Detective" [
        label=<
            <b>1.11 | Detective Safeguard</b><br/>
            <b>AWS Config Compliance Monitoring</b><br/>
            <b>Classification:</b> Detective<br/>
            <b>Description:</b> AWS Config rule ec2-imdsv2-check<br/>
            continuously verifies all EC2 instances have<br/>
            HttpTokens=required. Real-time alert on<br/>
            non-compliant instances. Weekly re-scan.
        >,
        shape=rectangle, style="filled", fillcolor="#0683FF", fontcolor="white"
    ];

    "2-SCE-Detective" [
        label=<
            <b>1.12 | SCE Detective Probe</b><br/>
            <b>Challenge:</b> Can Config detect IMDS<br/>
            configuration drift in real-time?<br/>
            <b>Expected Detection:</b> Config rule runs<br/>
            within &lt;5 min of instance change.<br/>
            Non-compliant instance flagged immediately.
        >,
        shape=rectangle, style="filled,rounded", fillcolor="#FFB84D", fontcolor="black"
    ];

    "2-Reactive" [
        label=<
            <b>1.13 | Reactive Safeguard</b><br/>
            <b>Automated Compliance Remediation</b><br/>
            <b>Classification:</b> Reactive<br/>
            <b>Description:</b> AWS Config auto-remediation<br/>
            Lambda reverts IMDS options to compliant state<br/>
            (HttpTokens=required, HopLimit=1).<br/>
            Terminate instance if remediation fails.
        >,
        shape=rectangle, style="filled", fillcolor="#0683FF", fontcolor="white"
    ];

    "2-SCE-Reactive" [
        label=<
            <b>1.14 | SCE Reactive Probe</b><br/>
            <b>Challenge:</b> Can remediation revert<br/>
            attacker&apos;s changes before credential theft?<br/>
            <b>Expected Response:</b> Auto-remediation reverts<br/>
            IMDS options &lt;1 min after drift detected.<br/>
            Verify HopLimit=1 + HttpTokens=required restored.
        >,
        shape=rectangle, style="filled,rounded", fillcolor="#FFB84D", fontcolor="black"
    ];

    // ============================================================================
    // STEP 3: WEAKEN INSTANCE METADATA SERVICE PROTECTIONS
    // ============================================================================

    "3-Preventive" [
        label=<
            <b>1.15 | Preventive Safeguard</b><br/>
            <b>IAM Permission Boundary: Block IMDS Modification</b><br/>
            <b>Classification:</b> Preventive<br/>
            <b>Description:</b> Deny ec2:ModifyInstanceMetadataOptions<br/>
            for all non-admin principals. Use permission<br/>
            boundaries to restrict scope. Require explicit<br/>
            approval + MFA for IMDS changes. Log attempts.
        >,
        shape=rectangle, style="filled", fillcolor="#0683FF", fontcolor="white"
    ];

    "3-Attack" [
        label=<
            <b>1.16 | Attack Step 3</b><br/>
            <b>Weaken IMDS Protections</b><br/>
            <b>Command:</b> aws ec2 modify-instance-metadata-options<br/>
            --instance-id &lt;ID&gt; --http-tokens optional<br/>
            --http-put-response-hop-limit 2<br/>
            <b>Dependencies:</b> ec2:ModifyInstanceMetadataOptions,<br/>
            target instance ID, instance running/stopped<br/>
            <b>Result:</b> IMDS downgraded to IMDSv1 + HopLimit=2.<br/>
            Metadata accessible from containers outside namespace.<br/>
            <b>TTP:</b> T1578.001 - Modify Cloud Infrastructure
        >,
        shape=rectangle, style="filled", fillcolor="#F40B0B", fontcolor="white"
    ];

    "3-SCE-Preventive" [
        label=<
            <b>1.17 | SCE Preventive Probe</b><br/>
            <b>Challenge:</b> Can attacker execute<br/>
            modify-instance-metadata-options without permission?<br/>
            <b>Expected Block:</b> IAM policy denies action.<br/>
            CloudTrail logs AccessDenied. Attacker<br/>
            cannot proceed. Incident alert triggers.
        >,
        shape=rectangle, style="filled,rounded", fillcolor="#FFB84D", fontcolor="black"
    ];

    "3-Detective" [
        label=<
            <b>1.18 | Detective Safeguard</b><br/>
            <b>CloudTrail + SIEM Modification Auditing</b><br/>
            <b>Classification:</b> Detective<br/>
            <b>Description:</b> CloudTrail captures all<br/>
            ModifyInstanceMetadataOptions calls with full<br/>
            parameters. SIEM rule alerts on downgrade to<br/>
            IMDSv1 or HopLimit increase.
        >,
        shape=rectangle, style="filled", fillcolor="#0683FF", fontcolor="white"
    ];

    "3-SCE-Detective" [
        label=<
            <b>1.19 | SCE Detective Probe</b><br/>
            <b>Challenge:</b> Can detection identify<br/>
            IMDS weakening attempt in real-time?<br/>
            <b>Expected Detection:</b> CloudTrail logs modify call<br/>
            within &lt;1 min. SIEM parses parameters;<br/>
            detects HopLimit=2 or HttpTokens=optional. Alert HIGH.
        >,
        shape=rectangle, style="filled,rounded", fillcolor="#FFB84D", fontcolor="black"
    ];

    "3-Reactive" [
        label=<
            <b>1.20 | Reactive Safeguard</b><br/>
            <b>Credential Revocation + Instance Isolation</b><br/>
            <b>Classification:</b> Reactive<br/>
            <b>Description:</b> Revoke attacker credentials immediately.<br/>
            Snapshot affected EC2 instance for forensics.<br/>
            Modify security group to deny all ingress/egress<br/>
            (quarantine). Terminate if compromise confirmed.
        >,
        shape=rectangle, style="filled", fillcolor="#0683FF", fontcolor="white"
    ];

    "3-SCE-Reactive" [
        label=<
            <b>1.21 | SCE Reactive Probe</b><br/>
            <b>Challenge:</b> Can system revert IMDS<br/>
            changes + revoke credentials before theft?<br/>
            <b>Expected Response:</b> Revoke &lt;5 min,<br/>
            revert IMDS &lt;2 min. Verify HopLimit=1<br/>
            + HttpTokens=required. Check blocked attempts.
        >,
        shape=rectangle, style="filled,rounded", fillcolor="#FFB84D", fontcolor="black"
    ];

    // ============================================================================
    // STEP 4: EXFILTRATE TEMPORARY CREDENTIALS VIA MODIFIED IMDS
    // ============================================================================

    "4-Preventive" [
        label=<
            <b>1.22 | Preventive Safeguard</b><br/>
            <b>Network Segmentation + VPC Endpoints</b><br/>
            <b>Classification:</b> Preventive<br/>
            <b>Description:</b> Restrict container network access<br/>
            to internal VPC only (no internet egress). Disable<br/>
            169.254.169.254 access from containers via SG/NACL.<br/>
            Use VPC Endpoints for AWS service calls instead of IMDS.
        >,
        shape=rectangle, style="filled", fillcolor="#0683FF", fontcolor="white"
    ];

    "4-Attack" [
        label=<
            <b>1.23 | Attack Step 4</b><br/>
            <b>Exfiltrate Credentials via Modified IMDS</b><br/>
            <b>Command:</b> curl http://169.254.169.254/latest/<br/>
            meta-data/iam/security-credentials/&lt;ROLE&gt;<br/>
            <b>Dependencies:</b> Network access to 169.254.169.254,<br/>
            HopLimit≥2, HttpTokens=optional, IAM role<br/>
            <b>Result:</b> Retrieved AccessKeyId, SecretAccessKey,<br/>
            Token, Expiration. Attacker gains temporary credentials.<br/>
            Enables lateral movement + privilege escalation.<br/>
            <b>TTP:</b> T1552.001 - Credentials in Files
        >,
        shape=rectangle, style="filled", fillcolor="#F40B0B", fontcolor="white"
    ];

    "4-SCE-Preventive" [
        label=<
            <b>1.24 | SCE Preventive Probe</b><br/>
            <b>Challenge:</b> Can container reach<br/>
            169.254.169.254 despite network restrictions?<br/>
            <b>Expected Block:</b> SG rule denies<br/>
            169.254.169.254 outbound. NACL rejects packets.<br/>
            curl fails with &quot;Connection refused&quot; or timeout.
        >,
        shape=rectangle, style="filled,rounded", fillcolor="#FFB84D", fontcolor="black"
    ];

    "4-Detective" [
        label=<
            <b>1.25 | Detective Safeguard</b><br/>
            <b>VPC Flow Logs + Anomaly Detection</b><br/>
            <b>Classification:</b> Detective<br/>
            <b>Description:</b> VPC Flow Logs capture traffic<br/>
            to 169.254.169.254. Alert on attempts from<br/>
            non-approved sources (containers, sidecars).<br/>
            Correlate with host-based IDS process logs.
        >,
        shape=rectangle, style="filled", fillcolor="#0683FF", fontcolor="white"
    ];

    "4-SCE-Detective" [
        label=<
            <b>1.26 | SCE Detective Probe</b><br/>
            <b>Challenge:</b> Can detection identify<br/>
            credential exfiltration attempt?<br/>
            <b>Expected Detection:</b> VPC Flow Log shows<br/>
            REJECT to 169.254.169.254 from container.<br/>
            Host IDS logs curl process. Alert CRITICAL &lt;1 min.
        >,
        shape=rectangle, style="filled,rounded", fillcolor="#FFB84D", fontcolor="black"
    ];

    "4-Reactive" [
        label=<
            <b>1.27 | Reactive Safeguard</b><br/>
            <b>Automated Threat Response</b><br/>
            <b>Classification:</b> Reactive<br/>
            <b>Description:</b> On exfiltration detection:<br/>
            1) Terminate EC2 instance immediately<br/>
            2) Revoke instance IAM role credentials<br/>
            3) Snapshot root volume for forensics<br/>
            4) Initiate incident response workflow<br/>
            5) Notify CISO + trigger PCI-DSS breach protocol
        >,
        shape=rectangle, style="filled", fillcolor="#0683FF", fontcolor="white"
    ];

    "4-SCE-Reactive" [
        label=<
            <b>1.28 | SCE Reactive Probe</b><br/>
            <b>Challenge:</b> Can system terminate<br/>
            instance + revoke credentials before<br/>
            stolen credentials are used?<br/>
            <b>Expected Response:</b> Terminate &lt;2 min,<br/>
            revoke &lt;5 min. Verify subsequent API calls<br/>
            with stolen credentials rejected.
        >,
        shape=rectangle, style="filled,rounded", fillcolor="#FFB84D", fontcolor="black"
    ];

    // ============================================================================
    // EDGES: MAIN ATTACK FLOW
    // ============================================================================

    Root -> "1-Preventive" [color="black", penwidth=2];
    "1-Preventive" -> "1-Attack" [color="black", penwidth=2];
    "1-Attack" -> "1-Detective" [color="black", penwidth=2];
    "1-Attack" -> "1-Reactive" [color="black", penwidth=2];
    "1-Detective" -> "2-Preventive" [color="black", penwidth=2];
    "1-Reactive" -> "2-Preventive" [color="black", penwidth=2];

    "2-Preventive" -> "2-Attack" [color="black", penwidth=2];
    "2-Attack" -> "2-Detective" [color="black", penwidth=2];
    "2-Attack" -> "2-Reactive" [color="black", penwidth=2];
    "2-Detective" -> "3-Preventive" [color="black", penwidth=2];
    "2-Reactive" -> "3-Preventive" [color="black", penwidth=2];

    "3-Preventive" -> "3-Attack" [color="black", penwidth=2];
    "3-Attack" -> "3-Detective" [color="black", penwidth=2];
    "3-Attack" -> "3-Reactive" [color="black", penwidth=2];
    "3-Detective" -> "4-Preventive" [color="black", penwidth=2];
    "3-Reactive" -> "4-Preventive" [color="black", penwidth=2];

    "4-Preventive" -> "4-Attack" [color="black", penwidth=2];
    "4-Attack" -> "4-Detective" [color="black", penwidth=2];
    "4-Attack" -> "4-Reactive" [color="black", penwidth=2];
    "4-Detective" -> "Final" [color="black", penwidth=2];
    "4-Reactive" -> "Final" [color="black", penwidth=2];

    // ============================================================================
    // EDGES: SECURITY CHAOS ENGINEERING PROBES (Dashed)
    // ============================================================================

    "1-Attack" -> "1-SCE-Preventive" [style=dashed, color="#FC8600", penwidth=1.5];
    "1-Attack" -> "1-SCE-Detective" [style=dashed, color="#FC8600", penwidth=1.5];
    "1-Attack" -> "1-SCE-Reactive" [style=dashed, color="#FC8600", penwidth=1.5];

    "2-Attack" -> "2-SCE-Preventive" [style=dashed, color="#FC8600", penwidth=1.5];
    "2-Attack" -> "2-SCE-Detective" [style=dashed, color="#FC8600", penwidth=1.5];
    "2-Attack" -> "2-SCE-Reactive" [style=dashed, color="#FC8600", penwidth=1.5];

    "3-Attack" -> "3-SCE-Preventive" [style=dashed, color="#FC8600", penwidth=1.5];
    "3-Attack" -> "3-SCE-Detective" [style=dashed, color="#FC8600", penwidth=1.5];
    "3-Attack" -> "3-SCE-Reactive" [style=dashed, color="#FC8600", penwidth=1.5];

    "4-Attack" -> "4-SCE-Preventive" [style=dashed, color="#FC8600", penwidth=1.5];
    "4-Attack" -> "4-SCE-Detective" [style=dashed, color="#FC8600", penwidth=1.5];
    "4-Attack" -> "4-SCE-Reactive" [style=dashed, color="#FC8600", penwidth=1.5];

    // ============================================================================
    // RANK CONSTRAINTS (Horizontal Alignment)
    // ============================================================================

    {rank=same; "1-Preventive"}
    {rank=same; "1-Attack"; "1-SCE-Preventive"}
    {rank=same; "1-Detective"; "1-SCE-Detective"; "1-Reactive"; "1-SCE-Reactive"}

    {rank=same; "2-Preventive"}
    {rank=same; "2-Attack"; "2-SCE-Preventive"}
    {rank=same; "2-Detective"; "2-SCE-Detective"; "2-Reactive"; "2-SCE-Reactive"}

    {rank=same; "3-Preventive"}
    {rank=same; "3-Attack"; "3-SCE-Preventive"}
    {rank=same; "3-Detective"; "3-SCE-Detective"; "3-Reactive"; "3-SCE-Reactive"}

    {rank=same; "4-Preventive"}
    {rank=same; "4-Attack"; "4-SCE-Preventive"}
    {rank=same; "4-Detective"; "4-SCE-Detective"; "4-Reactive"; "4-SCE-Reactive"}

    {rank=same; "Final"}
}