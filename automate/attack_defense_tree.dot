    node [fontname="Arial"];

    // ─────────────────────────────────────────────
    // ROOT NODE
    // ─────────────────────────────────────────────
    "Root_Node" [
        shape=rectangle, style=filled, fillcolor="#C6E8D1", fontcolor="black",
        label=<
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
                <TR><TD><B>ROOT: IMDS Protection Weakening Attack</B></TD></TR>
                <TR><TD><B>Attack ID:</B> aws-ec2-modify-imds-options-001</TD></TR>
                <TR><TD><B>Mission Context:</B> Cloud-Native Banking Platform on AWS EC2</TD></TR>
                <TR><TD><B>Attacker Goal:</B> Downgrade IMDS security to harvest IAM credentials and pivot</TD></TR>
                <TR><TD><B>STRIDE:</B> Tampering | Information Disclosure | Elevation of Privilege</TD></TR>
                <TR><TD><B>Threat Category:</B> Credential Theft &amp; IAM Abuse / EC2 Privilege Escalation</TD></TR>
            </TABLE>
        >, margin=0.3
    ];

    // ─────────────────────────────────────────────
    // STEP 1 — PREVENTIVE SAFEGUARD
    // ─────────────────────────────────────────────
    "1-Preventive" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="black",
        label=<
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
                <TR><TD><B>1.1 Preventive Safeguard — Block IMDS Weakening Attempt</B></TD></TR>
                <TR><TD><B>Classification:</B> Preventive</TD></TR>
                <TR><TD><B>Control 1 — SCP Deny ec2:ModifyInstanceMetadataOptions:</B></TD></TR>
                <TR><TD>AWS Organizations SCP hard-denies ec2:ModifyInstanceMetadataOptions</TD></TR>
                <TR><TD>for all principals except a break-glass InfraAdmin role, org-wide.</TD></TR>
                <TR><TD><B>Control 2 — IAM Least-Privilege + Permission Boundary:</B></TD></TR>
                <TR><TD>EC2 instance profiles and CodeBuild roles carry a Permission Boundary</TD></TR>
                <TR><TD>that explicitly denies ec2:ModifyInstanceMetadataOptions and</TD></TR>
                <TR><TD>ec2:DescribeInstances outside the InfraAdmin principal tag.</TD></TR>
                <TR><TD><B>Control 3 — Launch Template IMDSv2 Enforcement:</B></TD></TR>
                <TR><TD>All EC2 launch templates set HttpTokens=required, HopLimit=1</TD></TR>
                <TR><TD>as immutable IaC defaults; pipeline gate blocks any deviation.</TD></TR>
                <TR><TD><B>Control 4 — IAM Access Analyzer Continuous Review:</B></TD></TR>
                <TR><TD>Access Analyzer flags any role granting ec2:ModifyInstanceMetadataOptions</TD></TR>
                <TR><TD>outside the approved break-glass scope and raises a finding.</TD></TR>
            </TABLE>
        >, margin=0.3
    ];

    // ─────────────────────────────────────────────
    // STEP 1 — ATTACK NODE
    // ─────────────────────────────────────────────
    "1-Attack" [
        shape=rectangle, style=filled, fillcolor="#F40B0B", fontcolor="black",
        label=<
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
                <TR><TD><B>1.2 Step 1: Weaken IMDS Protections on Target EC2 Instance</B></TD></TR>
                <TR><TD><B>Command:</B></TD></TR>
                <TR><TD>aws ec2 modify-instance-metadata-options \</TD></TR>
                <TR><TD>  --instance-id &lt;INSTANCE_ID&gt; \</TD></TR>
                <TR><TD>  --http-tokens optional \</TD></TR>
                <TR><TD>  --http-endpoint enabled \</TD></TR>
                <TR><TD>  --http-put-response-hop-limit 2</TD></TR>
                <TR><TD><B>Dependencies:</B></TD></TR>
                <TR><TD>- IAM perm: ec2:ModifyInstanceMetadataOptions on target instance</TD></TR>
                <TR><TD>- IAM perm: ec2:DescribeInstances to identify instance ID</TD></TR>
                <TR><TD>- Valid AWS credentials (compromised IAM user or CI/CD role)</TD></TR>
                <TR><TD>- Target EC2 (transaction microservice host) running or stopped</TD></TR>
                <TR><TD><B>Result:</B></TD></TR>
                <TR><TD>HttpTokens set to optional (IMDSv1 re-enabled).</TD></TR>
                <TR><TD>HopLimit raised to 2 — IMDS reachable from containers hosting</TD></TR>
                <TR><TD>API gateway and transaction microservice tiers.</TD></TR>
                <TR><TD><B>TTP:</B> T1578 - Modify Cloud Compute Infrastructure</TD></TR>
            </TABLE>
        >, margin=0.3
    ];

    // ─────────────────────────────────────────────
    // STEP 1 — CHAOS NODE
    // ─────────────────────────────────────────────
    "1-Chaos" [
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", color="#FFA500", fontcolor="#000000",
        label=<
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
                <TR><TD><B>1.3 SCE Experiment — IMDS Weakening Probe</B></TD></TR>
                <TR><TD><B>SCE Node:</B> 3.3 | <B>Probe Coverage:</B> Preventive + Detective + Reactive</TD></TR>
                <TR><TD><B>Preventive Probe:</B></TD></TR>
                <TR><TD>Invoke IMDSModifyLambda assuming AttackerRole (Permission Boundary</TD></TR>
                <TR><TD>denies ec2:ModifyInstanceMetadataOptions). Validate SCP +</TD></TR>
                <TR><TD>boundary returns AccessDenied. Confirm DescribeInstances shows</TD></TR>
                <TR><TD>HttpTokens=required / HopLimit=1 unchanged after attempt.</TD></TR>
                <TR><TD><B>Detective Probe:</B></TD></TR>
                <TR><TD>Execute real ec2:ModifyInstanceMetadataOptions on a CFn-provisioned</TD></TR>
                <TR><TD>test instance. Confirm CloudTrail event appears in CloudWatch Logs</TD></TR>
                <TR><TD>trail group within 90s. Verify AWS Config custom rule evaluates</TD></TR>
                <TR><TD>instance as NON_COMPLIANT within 120s of manual evaluation trigger.</TD></TR>
                <TR><TD><B>Reactive Probe:</B></TD></TR>
                <TR><TD>Fire SSM signal representing GuardDuty-equivalent finding.</TD></TR>
                <TR><TD>Confirm EventBridge rule triggers RemediationLambda within 120s.</TD></TR>
                <TR><TD>Validate Lambda re-enforces HttpTokens=required via SSM done-param.</TD></TR>
                <TR><TD>Confirm SNS pager-notification received in SQS alert queue.</TD></TR>
            </TABLE>
        >, margin=0.3
    ];

    // ─────────────────────────────────────────────
    // STEP 1 — DETECTIVE SAFEGUARD
    // ─────────────────────────────────────────────
    "1-Detective" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="black",
        label=<
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
                <TR><TD><B>1.4 Detective Safeguard — Detect IMDS Config Modification</B></TD></TR>
                <TR><TD><B>Classification:</B> Detective</TD></TR>
                <TR><TD><B>Control 1 — CloudTrail + SIEM Correlation:</B></TD></TR>
                <TR><TD>CloudTrail logs ModifyInstanceMetadataOptions API call.</TD></TR>
                <TR><TD>SIEM rule fires alert on ec2:ModifyInstanceMetadataOptions</TD></TR>
                <TR><TD>with HttpTokens=optional or HopLimit &gt; 1 on any banking EC2.</TD></TR>
                <TR><TD><B>Control 2 — AWS Config Rule (imds-v2-required):</B></TD></TR>
                <TR><TD>Lambda-backed Config rule evaluates all tagged EC2 instances.</TD></TR>
                <TR><TD>NON_COMPLIANT finding raised when HttpTokens != &quot;required&quot;.</TD></TR>
                <TR><TD>Finding routed to Security Hub mapped to PCI-DSS Req 2.</TD></TR>
                <TR><TD><B>Control 3 — CloudWatch Metric Filter + Alarm:</B></TD></TR>
                <TR><TD>Metric filter on CloudTrail log group detects ModifyInstanceMetadataOptions</TD></TR>
                <TR><TD>events; CloudWatch Alarm transitions to ALARM and notifies Security Ops.</TD></TR>
