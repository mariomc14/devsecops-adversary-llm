digraph AttackDefenseTree {
    graph [
        fontname="Arial",
        splines=ortho,
        nodesep=0.6,
        ranksep=1.0,
        rankdir=TB,
        ordering="out",
        compound=true,
        bgcolor="white"
    ];
    node [fontname="Arial", margin="0.3,0.2"];

    // ============================================================
    // ROOT AND STRIDE GOAL NODES
    // ============================================================

    "Root_Node" [
        label=<
            <b>Root: EC2 IMDS Weakening Attack</b><br/>
            <b>Banking Platform - Cloud-Native Environment</b><br/>
            <font size="9">Attack ID: AWS-EC2-IMDS-WEAKENING-001</font>
        >,
        shape=rectangle, style=filled, fillcolor="#C6E8D1", fontcolor="black"
    ];

    "STRIDE_Node" [
        label=<
            <b>STRIDE Goals</b><br/>
            <font size="9">• Information Disclosure (Credentials)</font><br/>
            <font size="9">• Elevation of Privilege (IAM Assumption)</font><br/>
            <font size="9">• Tampering (IMDS Configuration)</font>
        >,
        shape=rectangle, style=filled, fillcolor="#FFE6E6", fontcolor="black"
    ];

    // ============================================================
    // ATTACK STEP 1: ENUMERATE IMDS CONFIGURATION
    // ============================================================

    "1_1_Preventive" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white",
        label=<
            <b>1.1 Restrict ec2:DescribeInstances</b><br/>
            <b>Classification: Preventive</b><br/>
            <font size="8"><i>Method:</i> Least-privilege IAM policy</font><br/>
            <font size="8"><i>Control:</i> Deny DescribeInstances to</font><br/>
            <font size="8">non-admin/non-devops roles via SCP</font><br/>
            <font size="8"><i>Intent:</i> Block reconnaissance phase</font>
        >, margin="0.2"
    ];

    "1_2_Attack" [
        shape=rectangle, style=filled, fillcolor="#F40B0B", fontcolor="white",
        label=<
            <b>1.2 Enumerate IMDS Configuration</b><br/>
            <b>TTP:</b> T1526 - System Network Discovery<br/>
            <font size="8"><b>Command:</b></font><br/>
            <font size="7">aws ec2 describe-instances</font><br/>
            <font size="7">--instance-ids &lt;ID&gt;</font><br/>
            <font size="8"><b>Dependency:</b> ec2:DescribeInstances</font><br/>
            <font size="8"><b>Result:</b> Attacker discovers</font><br/>
            <font size="8">HttpTokens, HopLimit values</font>
        >, margin="0.2"
    ];

    "1_3_Chaos" [
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", fontcolor="white",
        label=<
            <b>1.3 SCE: Enumeration Probe</b><br/>
            <font size="8"><b>Preventive:</b> Attempt DescribeInstances</font><br/>
            <font size="8">from non-admin role → AccessDenied</font><br/>
            <font size="8"><b>Detective:</b> CloudTrail records</font><br/>
            <font size="8">denied API call + principal</font><br/>
            <font size="8"><b>Reactive:</b> Alert + credential review</font>
        >, margin="0.2"
    ];

    "1_4_Detective" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white",
        label=<
            <b>1.4 Monitor CloudTrail for DescribeInstances</b><br/>
            <b>Classification: Detective</b><br/>
            <font size="8"><i>Method:</i> CloudTrail + CloudWatch Insights</font><br/>
            <font size="8"><i>Alert:</i> Unusual DescribeInstances calls</font><br/>
            <font size="8"><i>Baseline:</i> DevOps only, during windows</font><br/>
            <font size="8"><i>Anomaly:</i> Non-admin, off-hours, bulk query</font>
        >, margin="0.2"
    ];

    "1_5_Reactive" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white",
        label=<
            <b>1.5 Incident Response: Access Revocation</b><br/>
            <b>Classification: Reactive</b><br/>
            <font size="8"><i>Action:</i> If unauthorized DescribeInstances:</font><br/>
            <font size="8">1. Revoke caller IAM access</font><br/>
            <font size="8">2. Force re-authentication</font><br/>
            <font size="8">3. Alert security team</font><br/>
            <font size="8"><i>Timeline:</i> &lt;5 min from detection</font>
        >, margin="0.2"
    ];

    // ============================================================
    // ATTACK STEP 2: MODIFY IMDS CONFIGURATION
    // ============================================================

    "2_1_Preventive" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white",
        label=<
            <b>2.1 Enforce IMDSv2 via SCP &amp; Config Rules</b><br/>
            <b>Classification: Preventive</b><br/>
            <font size="8"><i>Method:</i> AWS Organizations SCP</font><br/>
            <font size="8"><i>Policy:</i> Deny ModifyInstanceMetadataOptions</font><br/>
            <font size="8">if HttpTokens=optional OR HopLimit&gt;1</font><br/>
            <font size="8"><i>Scope:</i> Organization-wide enforcement</font>
        >, margin="0.2"
    ];

    "2_2_Attack" [
        shape=rectangle, style=filled, fillcolor="#F40B0B", fontcolor="white",
        label=<
            <b>2.2 Modify IMDS Configuration</b><br/>
            <b>TTP:</b> T1578.001 - Modify Cloud Infrastructure<br/>
            <font size="8"><b>Command:</b></font><br/>
            <font size="7">aws ec2 modify-instance-metadata-options</font><br/>
            <font size="7">--http-tokens optional --http-put-response-hop-limit 2</font><br/>
            <font size="8"><b>Result:</b> IMDSv1 enabled, metadata</font><br/>
            <font size="8">endpoint accessible from containers/procs</font>
        >, margin="0.2"
    ];

    "2_3_Chaos" [
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", fontcolor="white",
        label=<
            <b>2.3 SCE: IMDS Modification Probe</b><br/>
            <font size="8"><b>Preventive:</b> Attempt modify with SCP</font><br/>
            <font size="8">active → AccessDenied, config unchanged</font><br/>
            <font size="8"><b>Detective:</b> CloudTrail logs unauthorized</font><br/>
            <font size="8">attempt within 60s</font><br/>
            <font size="8"><b>Reactive:</b> Lambda reverts config,</font><br/>
            <font size="8">isolates instance, triggers IR</font>
        >, margin="0.2"
    ];

    "2_4_Detective" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white",
        label=<
            <b>2.4 Detect IMDS Modifications</b><br/>
            <b>Classification: Detective</b><br/>
            <font size="8"><i>Method:</i> CloudTrail + Config Rule</font><br/>
            <font size="8"><i>Alert:</i> Unauthorized ModifyInstanceMetadataOptions</font><br/>
            <font size="8"><i>Baseline:</i> Infra automation only</font><br/>
            <font size="8"><i>Anomaly:</i> Non-admin, weaken security params</font>
        >, margin="0.2"
    ];

    "2_5_Reactive" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white",
        label=<
            <b>2.5 Quarantine &amp; Revert Configuration</b><br/>
            <b>Classification: Reactive</b><br/>
            <font size="8"><i>Actions (Automated):</i></font><br/>
            <font size="8">1. Revert HttpTokens→required, HopLimit→1</font><br/>
            <font size="8">2. Modify SG → deny all egress</font><br/>
            <font size="8">3. Create forensic EBS snapshots</font><br/>
            <font size="8">4. Notify security team via SNS</font><br/>
            <font size="8"><i>Timeline:</i> &lt;5 min from alert</font>
        >, margin="0.2"
    ];

    // ============================================================
    // ATTACK STEP 3: EXPLOIT WEAKENED IMDS FOR CREDENTIAL THEFT
    // ============================================================

    "3_1_Preventive" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white",
        label=<
            <b>3.1 Enforce IMDSv2 Token Requirement</b><br/>
            <b>Classification: Preventive</b><br/>
            <font size="8"><i>Method:</i> EC2 Image Builder hardened AMI</font><br/>
            <font size="8"><i>Control:</i> Disable IMDSv1 via iptables</font><br/>
            <font size="8">DROP non-token IMDS requests</font><br/>
            <font size="8"><i>Enforce:</i> HttpTokens=required, HopLimit=1</font>
        >, margin="0.2"
    ];

    "3_2_Attack" [
        shape=rectangle, style=filled, fillcolor="#F40B0B", fontcolor="white",
        label=<
            <b>3.2 Exploit Weakened IMDS</b><br/>
            <b>TTP:</b> T1552.001 - Credentials in Cloud Instances<br/>
            <font size="8"><b>Commands:</b></font><br/>
            <font size="7">curl PUT /latest/api/token (IMDSv2)</font><br/>
            <font size="7">curl /latest/meta-data/iam/security-credentials/</font><br/>
            <font size="8"><b>Result:</b> Temporary AWS credentials</font><br/>
            <font size="8">exfiltrated (AccessKeyId, SecretAccessKey, Token)</font>
        >, margin="0.2"
    ];

    "3_3_Chaos" [
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", fontcolor="white",
        label=<
            <b>3.3 SCE: Credential Extraction Probe</b><br/>
            <font size="8"><b>Preventive:</b> Attempt IMDSv1 from hardened</font><br/>
            <font size="8">AMI → iptables DROP, no credentials</font><br/>
            <font size="8"><b>Detective:</b> VPC Flow Logs show attempt,</font><br/>
            <font size="8">CloudWatch captures process</font><br/>
            <font size="8"><b>Reactive:</b> Lambda revokes creds,</font><br/>
            <font size="8">forensic snapshot, incident escalation</font>
        >, margin="0.2"
    ];

    "3_4_Detective" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white",
        label=<
            <b>3.4 Detect IMDSv1 Requests &amp; Credential Access</b><br/>
            <b>Classification: Detective</b><br/>
            <font size="8"><i>Method:</i> VPC Flow Logs + CloudWatch Agent</font><br/>
            <font size="8"><i>Baseline:</i> Only IMDSv2 PUT token requests</font><br/>
            <font size="8"><i>Anomaly:</i> GET to 169.254.169.254, /iam/security-credentials/</font><br/>
            <font size="8"><i>Alert:</i> CRITICAL → incident response</font>
        >, margin="0.2"
    ];

    "3_5_Reactive" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white",
        label=<
            <b>3.5 Revoke Compromised Credentials</b><br/>
            <b>Classification: Reactive</b><br/>
            <font size="8"><i>Actions (Automated):</i></font><br/>
            <font size="8">1. Analyze CloudTrail for unauthorized APIs</font><br/>
            <font size="8">2. Issue forensic-only temporary creds</font><br/>
            <font size="8">3. Quarantine instance; block egress</font><br/>
            <font size="8">4. Create forensic snapshots + S3 storage</font><br/>
            <font size="8">5. Notify security + compliance teams</font><br/>
            <font size="8"><i>Timeline:</i> &lt;10 min from detection</font>
        >, margin="0.2"
    ];

    // ============================================================
    // OUTCOME AND STRIDE CLASSIFICATION
    // ============================================================

    "Final_Node" [
        label=<
            <b>STRIDE Outcome: Attack Chain Neutralized</b><br/>
            <font size="9">✓ Information Disclosure: Prevented (no cred exfil)</font><br/>
            <font size="9">✓ Elevation of Privilege: Blocked (IMDS hardened)</font><br/>
            <font size="9">✓ Tampering: Detected &amp; Reverted (config restored)</font>
        >,
        shape=rectangle, style=filled, fillcolor="#C6E8D1", fontcolor="black"
    ];

    // ============================================================
    // SAFEGUARD SUMMARY NODE
    // ============================================================

    "Safeguard_Summary" [
        label=<
            <b>Defense-in-Depth Summary</b><br/>
            <font size="8"><b>Preventive (Layer 1):</b> IAM SCP, hardened AMI, disable IMDSv1</font><br/>
            <font size="8"><b>Detective (Layer 2):</b> CloudTrail, Config Rules, VPC Flow Logs</font><br/>
            <font size="8"><b>Reactive (Layer 3):</b> Lambda IR, config revert, forensic capture</font>
        >,
        shape=rectangle, style=filled, fillcolor="#E0E0E0", fontcolor="black"
    ];

    // ============================================================
    // RANKING / ALIGNMENT
    // ============================================================

    {rank=same; "Root_Node"; "STRIDE_Node"}
    {rank=same; "1_1_Preventive"; "1_2_Attack"; "1_3_Chaos"}
    {rank=same; "1_4_Detective"; "1_5_Reactive"}
    {rank=same; "2_1_Preventive"; "2_2_Attack"; "2_3_Chaos"}
    {rank=same; "2_4_Detective"; "2_5_Reactive"}
    {rank=same; "3_1_Preventive"; "3_2_Attack"; "3_3_Chaos"}
    {rank=same; "3_4_Detective"; "3_5_Reactive"}
    {rank=same; "Final_Node"; "Safeguard_Summary"}

    // ============================================================
    // FLOW EDGES
    // ============================================================

    // Root to STRIDE to Step 1
    "Root_Node" -> "STRIDE_Node" [style=bold, color="#333333", penwidth=2];
    "STRIDE_Node" -> "1_1_Preventive" [style=solid, color="#333333"];

    // Step 1: Preventive -> Attack -> Chaos + Detective + Reactive
    "1_1_Preventive" -> "1_2_Attack" [style=solid, color="#333333"];
    "1_2_Attack" -> "1_3_Chaos" [style=dashed, color="#FC8600", penwidth=1.5, label="SCE"];
    "1_2_Attack" -> "1_4_Detective" [style=solid, color="#0683FF"];
    "1_4_Detective" -> "1_5_Reactive" [style=solid, color="#0683FF"];
    "1_3_Chaos" -> "1_4_Detective" [style=dotted, color="#999999"];

    // Step 1 -> Step 2
    "1_5_Reactive" -> "2_1_Preventive" [style=bold, color="#333333"];
    "1_4_Detective" -> "2_1_Preventive" [style=bold, color="#333333"];

    // Step 2: Preventive -> Attack -> Chaos + Detective + Reactive
    "2_1_Preventive" -> "2_2_Attack" [style=solid, color="#333333"];
    "2_2_Attack" -> "2_3_Chaos" [style=dashed, color="#FC8600", penwidth=1.5, label="SCE"];
    "2_2_Attack" -> "2_4_Detective" [style=solid, color="#0683FF"];
    "2_4_Detective" -> "2_5_Reactive" [style=solid, color="#0683FF"];
    "2_3_Chaos" -> "2_4_Detective" [style=dotted, color="#999999"];

    // Step 2 -> Step 3
    "2_5_Reactive" -> "3_1_Preventive" [style=bold, color="#333333"];
    "2_4_Detective" -> "3_1_Preventive" [style=bold, color="#333333"];

    // Step 3: Preventive -> Attack -> Chaos + Detective + Reactive
    "3_1_Preventive" -> "3_2_Attack" [style=solid, color="#333333"];
    "3_2_Attack" -> "3_3_Chaos" [style=dashed, color="#FC8600", penwidth=1.5, label="SCE"];
    "3_2_Attack" -> "3_4_Detective" [style=solid, color="#0683FF"];
    "3_4_Detective" -> "3_5_Reactive" [style=solid, color="#0683FF"];
    "3_3_Chaos" -> "3_4_Detective" [style=dotted, color="#999999"];

    // Step 3 -> Outcome
    "3_5_Reactive" -> "Final_Node" [style=bold, color="#333333", penwidth=2];
    "3_4_Detective" -> "Final_Node" [style=bold, color="#333333", penwidth=2];

    // Summary node connections
    "Final_Node" -> "Safeguard_Summary" [style=dotted, color="#666666"];

    // ============================================================
    // LEGEND
    // ============================================================

    "Legend_Title" [
        label="Legend",
        shape=rectangle, style=filled, fillcolor="#FFFFFF", fontcolor="black",
        fontsize=11
    ];

    "Legend_Red" [
        label="Red: Attack Step",
        shape=rectangle, style=filled, fillcolor="#F40B0B", fontcolor="white"
    ];

    "Legend_Blue" [
        label="Blue: Safeguard (P/D/R)",
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white"
    ];

    "Legend_Orange" [
        label="Orange: SCE Probe",
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", fontcolor="white"
    ];

    "Legend_Green" [
        label="Green: Outcome Node",
        shape=rectangle, style=filled, fillcolor="#C6E8D1", fontcolor="black"
    ];

    "Legend_Gray" [
        label="Gray: Summary",
        shape=rectangle, style=filled, fillcolor="#E0E0E0", fontcolor="black"
    ];

    {rank=same; "Legend_Title"; "Legend_Red"; "Legend_Blue"; "Legend_Orange"; "Legend_Green"; "Legend_Gray"}
}