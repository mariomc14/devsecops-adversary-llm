digraph AttackGraph {
    graph [
        fontname="Arial",
        splines=ortho,
        nodesep=0.5,
        ranksep=0.75,
        rankdir=TB,
        ordering="out",
        compound=true
    ];
    node [fontname="Arial"];

    "Root_Node" [label="AWS CodeBuild Security Scenario", 
        shape=rectangle, style=filled, fillcolor="#C6E8D1", fontcolor="black"];

    "1-Preventive" [
        label=<
            <b>1.1 IAM Least Privilege Control</b><br/>
            <b>Classification: Preventive</b><br/>
            <b>Strategy:</b> Restrict CodeBuild IAM permissions<br/>
            <b>Mechanism:</b> Fine-grained IAM role scoping
        >, shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="black"
    ];

    "1-Attack" [
        label=<
            <b>1.2 Create Malicious CodeBuild Project</b><br/>
            <b>Command:</b> aws codebuild create-project<br/>
            <b>Dependencies:</b> iam:PassRole, codebuild:CreateProject<br/>
            <b>Result:</b> Malicious project creation<br/>
            <b>TTP:</b> T1552.005 Unsecured Credentials
        >, shape=rectangle, style=filled, fillcolor="#F40B0B", fontcolor="black"
    ];

    "1-Chaos" [
        label=<
            <b>1.3 SCE Experiment</b><br/>
            <b>Preventive Probe:</b> Can IAM restrictions block project creation?<br/>
            <b>Detective Probe:</b> Will logging capture suspicious project setup?<br/>
            <b>Reactive Probe:</b> Can automatic remediation trigger?
        >, shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", color="#FFA500", fontcolor="black"
    ];

    "1-Detective" [
        label=<
            <b>1.4 CodeBuild Activity Monitoring</b><br/>
            <b>Classification: Detective</b><br/>
            <b>Strategy:</b> CloudTrail logging, CloudWatch alerts<br/>
            <b>Mechanism:</b> Real-time project creation monitoring
        >, shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="black"
    ];

    "1-Reactive" [
        label=<
            <b>1.5 Incident Response</b><br/>
            <b>Classification: Reactive</b><br/>
            <b>Strategy:</b> Automated project deletion<br/>
            <b>Mechanism:</b> Lambda-triggered remediation
        >, shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="black"
    ];

    "2-Preventive" [
        label=<
            <b>1.6 Metadata Service Protection</b><br/>
            <b>Classification: Preventive</b><br/>
            <b>Strategy:</b> IMDSv2, restricted metadata access<br/>
            <b>Mechanism:</b> Session-oriented metadata retrieval
        >, shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="black"
    ];

    "2-Attack" [
        label=<
            <b>1.7 Start Malicious Build</b><br/>
            <b>Command:</b> aws codebuild start-build<br/>
            <b>Dependencies:</b> Malicious project exists<br/>
            <b>Result:</b> Credential exposure attempt<br/>
            <b>TTP:</b> T1098.001 Account Manipulation
        >, shape=rectangle, style=filled, fillcolor="#F40B0B", fontcolor="black"
    ];

    "2-Chaos" [
        label=<
            <b>1.8 SCE Experiment</b><br/>
            <b>Preventive Probe:</b> Can build initiation be blocked?<br/>
            <b>Detective Probe:</b> Will runtime monitoring detect extraction?<br/>
            <b>Reactive Probe:</b> Can build be immediately terminated?
        >, shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", color="#FFA500", fontcolor="black"
    ];

    "2-Detective" [
        label=<
            <b>1.9 Runtime Container Monitoring</b><br/>
            <b>Classification: Detective</b><br/>
            <b>Strategy:</b> Container runtime analysis<br/>
            <b>Mechanism:</b> Behavioral anomaly detection
        >, shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="black"
    ];

    "2-Reactive" [
        label=<
            <b>1.10 Credential Revocation</b><br/>
            <b>Classification: Reactive</b><br/>
            <b>Strategy:</b> Immediate credential invalidation<br/>
            <b>Mechanism:</b> Automated IAM role rotation
        >, shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="black"
    ];

    "Final_Node" [label="STRIDE Goal: Information Disclosure & Privilege Escalation", 
        shape=rectangle, style=filled, fillcolor="#C6E8D1", fontcolor="black"];

    // Graph connections
    "Root_Node" -> "1-Preventive";
    "1-Preventive" -> "1-Attack";
    "1-Attack" -> "1-Chaos" [style=dashed, color="#FC8600"];
    "1-Attack" -> "1-Detective";
    "1-Attack" -> "1-Reactive";
    "1-Detective" -> "2-Preventive";
    "1-Reactive" -> "2-Preventive";

    "2-Preventive" -> "2-Attack";
    "2-Attack" -> "2-Chaos" [style=dashed, color="#FC8600"];
    "2-Attack" -> "2-Detective";
    "2-Attack" -> "2-Reactive";
    "2-Detective" -> "Final_Node";
    "2-Reactive" -> "Final_Node";
}