digraph AWS_EC2_IMDS_Complete_ADT {
    graph [
        fontname="Arial",
        splines=ortho,
        nodesep=0.8,
        ranksep=1.2,
        rankdir=TB,
        ordering="out",
        compound=true
    ];
    node [fontname="Arial", margin="0.3,0.2"];

    // ============================================================================
    // ROOT NODE
    // ============================================================================
    "Root" [
        label=<
            <b>ROOT: EC2 IMDS Weakening Attack</b><br/>
            <b>Scenario:</b> Cloud-Native Banking Platform<br/>
            <b>Attacker Goal:</b> Steal temporary AWS credentials via IMDS<br/>
            <b>STRIDE:</b> Information Disclosure, Elevation of Privilege<br/>
        >,
        shape=rectangle, style=filled, fillcolor="#C6E8D1", fontcolor="black", width=5.5
    ];

    // ============================================================================
    // ATTACK STEP 1: Verify IMDS Configuration (T1526)
    // ============================================================================

    "1.1-Preventive" [
        label=<
            <b>1.1 PREVENTIVE: IAM Permission Boundary</b><br/>
            <b>Classification:</b> Preventive<br/>
            <b>Control:</b> Restrict ec2:DescribeInstances<br/>
            <b>Implementation:</b><br/>
            • Deny DescribeInstances from CodeBuild role on prod instances<br/>
            • Resource ARN scoping (dev/staging only)<br/>
            • Source IP condition: build VPC CIDR only<br/>
        >,
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white", width=5.5
    ];

    "1.2-Attack" [
        label=<
            <b>1.2 ATTACK: Reconnaissance - IMDS Configuration Discovery</b><br/>
            <b>TTP:</b> T1526 - Gather System Network Configuration<br/>
            <b>Command:</b> aws ec2 describe-instances --instance-ids &lt;ID&gt;<br/>
            <b>Dependencies:</b> ec2:DescribeInstances permission, target instance exists<br/>
            <b>Result:</b> Attacker discovers HttpTokens, HopLimit, HttpEndpoint settings<br/>
        >,
        shape=rectangle, style=filled, fillcolor="#F40B0B", fontcolor="white", width=5.5
    ];

    "1.3-Chaos" [
        label=<
            <b>1.3 SCE EXPERIMENT: Reconnaissance Denial</b><br/>
            <b>Preventive Probe:</b> Attempt describe-instances from CodeBuild role;<br/>
            verify IAM deny blocks with UnauthorizedOperation<br/>
            <b>Detective Probe:</b> Verify CloudTrail logs denied API call;<br/>
            confirm alert in SIEM &lt;10sec<br/>
            <b>Reactive Probe:</b> Verify credential revocation &lt;2min<br/>
        >,
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", fontcolor="#000000", width=5.5
    ];

    "1.4-Detective" [
        label=<
            <b>1.4 DETECTIVE: CloudTrail + GuardDuty Logging</b><br/>
            <b>Classification:</b> Detective<br/>
            <b>Mechanism:</b> API call logging &amp; anomaly detection<br/>
            <b>Implementation:</b><br/>
            • CloudTrail logs DescribeInstances with principal context<br/>
            • GuardDuty detects reconnaissance pattern<br/>
            • EventBridge correlation triggers SIEM alert<br/>
        >,
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white", width=5.5
    ];

    "1.5-Reactive" [
        label=<
            <b>1.5 REACTIVE: Incident Response - Session Revocation</b><br/>
            <b>Classification:</b> Reactive<br/>
            <b>Mechanism:</b> Automatic credential invalidation<br/>
            <b>Implementation:</b><br/>
            • Lambda revokes CodeBuild temporary credentials<br/>
            • Issue new STS tokens (invalidates old ones)<br/>
            • Create incident ticket; notify security team<br/>
        >,
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white", width=5.5
    ];

    // ============================================================================
    // ATTACK STEP 2: Weaken IMDS - Disable Token Requirement
    // ============================================================================

    "2.1-Preventive" [
        label=<
            <b>2.1 PREVENTIVE: SCP + IAM Explicit Deny</b><br/>
            <b>Classification:</b> Preventive<br/>
            <b>Mechanism:</b> Org-level Service Control Policy<br/>
            <b>Implementation:</b><br/>
            • SCP denies ec2:ModifyInstanceMetadataOptions for all except SecurityAudit<br/>
            • IAM boundary: explicit deny on HttpTokens modification<br/>
            • Cannot be bypassed (deny precedence over allow)<br/>
        >,
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white", width=5.5
    ];

    "2.2-Attack" [
        label=<
            <b>2.2 ATTACK: Weaken IMDS - Disable Token Requirement</b><br/>
            <b>TTP:</b> T1199 - Trusted Relationship Abuse<br/>
            <b>Command:</b> aws ec2 modify-instance-metadata-options --http-tokens optional<br/>
            <b>Dependencies:</b> ec2:ModifyInstanceMetadataOptions permission, instance running/stopped<br/>
            <b>Result:</b> IMDS downgraded IMDSv2→IMDSv1 (no token required)<br/>
        >,
        shape=rectangle, style=filled, fillcolor="#F40B0B", fontcolor="white", width=5.5
    ];

    "2.3-Chaos" [
        label=<
            <b>2.3 SCE EXPERIMENT: IMDS Downgrade Prevention</b><br/>
            <b>Preventive Probe:</b> Attempt HttpTokens=optional modification;<br/>
            verify SCP/IAM deny returns UnauthorizedOperation<br/>
            <b>Detective Probe:</b> Verify CloudTrail + Config detects attempt;<br/>
            confirm ec2-imds-v2-check alerts &lt;10sec<br/>
            <b>Reactive Probe:</b> Verify auto-remediation reverts to IMDSv2 &lt;1min<br/>
        >,
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", fontcolor="#000000", width=5.5
    ];

    "2.4-Detective" [
        label=<
            <b>2.4 DETECTIVE: CloudTrail + AWS Config Compliance</b><br/>
            <b>Classification:</b> Detective<br/>
            <b>Mechanism:</b> Real-time policy compliance monitoring<br/>
            <b>Implementation:</b><br/>
            • CloudTrail real-time alert on ModifyInstanceMetadataOptions<br/>
            • AWS Config rule ec2-imds-v2-check on HttpTokens change<br/>
            • VPC Flow Logs capture outbound patterns<br/>
        >,
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white", width=5.5
    ];

    "2.5-Reactive" [
        label=<
            <b>2.5 REACTIVE: Auto-Remediation + Isolation</b><br/>
            <b>Classification:</b> Reactive<br/>
            <b>Mechanism:</b> Configuration reversion &amp; instance quarantine<br/>
            <b>Implementation:</b><br/>
            • Lambda reverts HttpTokens to required; HopLimit to 1<br/>
            • Move instance to quarantine SG (no egress)<br/>
            • Create EBS snapshot for forensic analysis<br/>
        >,
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white", width=5.5
    ];

    // ============================================================================
    // ATTACK STEP 3: Increase IMDS Hop Limit
    // ============================================================================

    "3.1-Preventive" [
        label=<
            <b>3.1 PREVENTIVE: SCP Condition on Hop Limit</b><br/>
            <b>Classification:</b> Preventive<br/>
            <b>Mechanism:</b> Policy condition restricting parameter value<br/>
            <b>Implementation:</b><br/>
            • SCP denies ModifyInstanceMetadataOptions where HopLimit &gt; 1<br/>
            • AWS Config rule enforces HopLimit ≤ 1<br/>
            • SSM Document auto-remediation on drift<br/>
        >,
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white", width=5.5
    ];

    "3.2-Attack" [
        label=<
            <b>3.2 ATTACK: Increase IMDS Hop Limit</b><br/>
            <b>TTP:</b> T1552.001 - Unsecured Credentials - Credentials In Files<br/>
            <b>Command:</b> aws ec2 modify-instance-metadata-options --http-put-response-hop-limit 2<br/>
            <b>Dependencies:</b> ec2:ModifyInstanceMetadataOptions permission, instance state<br/>
            <b>Result:</b> HopLimit increased 1→2; metadata accessible from containers<br/>
        >,
        shape=rectangle, style=filled, fillcolor="#F40B0B", fontcolor="white", width=5.5
    ];

    "3.3-Chaos" [
        label=<
            <b>3.3 SCE EXPERIMENT: Hop Limit Restriction</b><br/>
            <b>Preventive Probe:</b> Attempt HopLimit=2 modification;<br/>
            verify SCP condition denies<br/>
            <b>Detective Probe:</b> Verify Config drift detection &lt;5min;<br/>
            CloudTrail shows parameter context<br/>
            <b>Reactive Probe:</b> Verify auto-remediation to HopLimit=1 &lt;2min<br/>
        >,
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", fontcolor="#000000", width=5.5
    ];

    "3.4-Detective" [
        label=<
            <b>3.4 DETECTIVE: Falco + VPC Flow Logs</b><br/>
            <b>Classification:</b> Detective<br/>
            <b>Mechanism:</b> Runtime container behavior &amp; network traffic<br/>
            <b>Implementation:</b><br/>
            • Falco alerts on container querying 169.254.169.254<br/>
            • VPC Flow Logs detect outbound to metadata IP:80<br/>
            • CloudWatch: IMDS request spike anomaly detection<br/>
        >,
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white", width=5.5
    ];

    "3.5-Reactive" [
        label=<
            <b>3.5 REACTIVE: Container Kill + Credential Rotation</b><br/>
            <b>Classification:</b> Reactive<br/>
            <b>Mechanism:</b> Hostile container termination &amp; credential invalidation<br/>
            <b>Implementation:</b><br/>
            • Falco triggers OPA admission controller to kill container<br/>
            • Lambda reverts HopLimit to 1<br/>
            • Issue new instance IAM credentials (invalidates stolen)<br/>
        >,
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white", width=5.5
    ];

    // ============================================================================
    // ATTACK STEP 4: Retrieve Credentials from IMDS
    // ============================================================================

    "4.1-Preventive" [
        label=<
            <b>4.1 PREVENTIVE: IMDSv2 + Network Segmentation</b><br/>
            <b>Classification:</b> Preventive<br/>
            <b>Mechanism:</b> Token-based access &amp; network isolation<br/>
            <b>Implementation:</b><br/>
            • IMDSv2 enforced: session token requirement (blocks simple curl)<br/>
            • Kubernetes Network Policy: deny outbound to 169.254.169.254<br/>
            • Host iptables: DROP packets from container to metadata<br/>
            • Workload Identity (IRSA): pod-level credentials (not instance profile)<br/>
        >,
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white", width=5.5
    ];

    "4.2-Attack" [
        label=<
            <b>4.2 ATTACK: Steal Credentials from IMDS</b><br/>
            <b>TTP:</b> T1552.005 - Unsecured Credentials - Cloud Instance Metadata API<br/>
            <b>Command:</b> curl http://169.254.169.254/latest/meta-data/iam/security-credentials/&lt;ROLE&gt;<br/>
            <b>Dependencies:</b> IMDS weakened (IMDSv1 + HopLimit ≥ 2), network access to 169.254.169.254<br/>
            <b>Result:</b> Attacker retrieves temporary AWS credentials (AccessKeyId, SecretAccessKey, SessionToken)<br/>
        >,
        shape=rectangle, style=filled, fillcolor="#F40B0B", fontcolor="white", width=5.5
    ];

    "4.3-Chaos" [
        label=<
            <b>4.3 SCE EXPERIMENT: Credential Exfiltration Prevention</b><br/>
            <b>Preventive Probe:</b> Attempt metadata query from container;<br/>
            verify IMDSv2 token requirement blocks; test network policy<br/>
            <b>Detective Probe:</b> Verify Falco + VPC Flow Logs detect query;<br/>
            alert in SIEM &lt;10sec<br/>
            <b>Reactive Probe:</b> Verify credential revocation blocks API calls &lt;30sec<br/>
        >,
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", fontcolor="#000000", width=5.5
    ];

    "4.4-Detective" [
        label=<
            <b>4.4 DETECTIVE: Falco + GuardDuty + CloudTrail</b><br/>
            <b>Classification:</b> Detective<br/>
            <b>Mechanism:</b> Multi-signal behavioral anomaly detection<br/>
            <b>Implementation:</b><br/>
            • Falco: Alert on process querying 169.254.169.254 in container<br/>
            • CloudWatch: IMDS request spike (custom metric anomaly)<br/>
            • GuardDuty: Unusual API calls from stolen credentials<br/>
            • SIEM: Cross-reference all signals for attack correlation<br/>
        >,
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white", width=5.5
    ];

    "4.5-Reactive" [
        label=<
            <b>4.5 REACTIVE: Credential Invalidation + Forensic Containment</b><br/>
            <b>Classification:</b> Reactive<br/>
            <b>Mechanism:</b> Emergency credential revocation &amp; incident capture<br/>
            <b>Implementation:</b><br/>
            • Lambda revokes instance IAM role credentials immediately<br/>
            • Issue new STS token (invalidates stolen credentials)<br/>
            • Quarantine instance &amp; containers (network isolation)<br/>
            • Capture EBS snapshot + memory dump for forensics<br/>
            • Block API calls from stolen credentials (token blacklist)<br/>
        >,
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white", width=5.5
    ];

    // ============================================================================
    // FINAL NODE
    // ============================================================================
    "Final" [
        label=<
            <b>FINAL: Attack Outcome (STRIDE Classification)</b><br/>
            <b>Information Disclosure:</b> Temporary AWS credentials exfiltrated<br/>
            <b>Elevation of Privilege:</b> Attacker assumes instance IAM role permissions<br/>
            <b>Threat Level:</b> CRITICAL (Full AWS environment compromise)<br/>
            <b>Defense Status:</b> 4 layers (prevent/detect/react)<br/>
        >,
        shape=rectangle, style=filled, fillcolor="#C6E8D1", fontcolor="black", width=5.5
    ];

    // ============================================================================
    // GRAPH CONNECTIONS
    // ============================================================================
    
    // Attack Step 1 Flow
    "Root" -> "1.1-Preventive" [style=solid, color="#0683FF", penwidth=2.5, label="Defense"];
    "1.1-Preventive" -> "1.2-Attack" [style=solid, color="#333333", penwidth=2.5];
    "1.2-Attack" -> "1.3-Chaos" [style=dashed, color="#FC8600", penwidth=2, label="SCE Test"];
    "1.2-Attack" -> "1.4-Detective" [style=solid, color="#333333", penwidth=2.5];
    "1.2-Attack" -> "1.5-Reactive" [style=solid, color="#333333", penwidth=2.5];

    "1.4-Detective" -> "2.1-Preventive" [style=solid, color="#0683FF", penwidth=2.5];
    "1.5-Reactive" -> "2.1-Preventive" [style=solid, color="#0683FF", penwidth=2.5];

    // Attack Step 2 Flow
    "2.1-Preventive" -> "2.2-Attack" [style=solid, color="#333333", penwidth=2.5];
    "2.2-Attack" -> "2.3-Chaos" [style=dashed, color="#FC8600", penwidth=2, label="SCE Test"];
    "2.2-Attack" -> "2.4-Detective" [style=solid, color="#333333", penwidth=2.5];
    "2.2-Attack" -> "2.5-Reactive" [style=solid, color="#333333", penwidth=2.5];

    "2.4-Detective" -> "3.1-Preventive" [style=solid, color="#0683FF", penwidth=2.5];
    "2.5-Reactive" -> "3.1-Preventive" [style=solid, color="#0683FF", penwidth=2.5];

    // Attack Step 3 Flow
    "3.1-Preventive" -> "3.2-Attack" [style=solid, color="#333333", penwidth=2.5];
    "3.2-Attack" -> "3.3-Chaos" [style=dashed, color="#FC8600", penwidth=2, label="SCE Test"];
    "3.2-Attack" -> "3.4-Detective" [style=solid, color="#333333", penwidth=2.5];
    "3.2-Attack" -> "3.5-Reactive" [style=solid, color="#333333", penwidth=2.5];

    "3.4-Detective" -> "4.1-Preventive" [style=solid, color="#0683FF", penwidth=2.5];
    "3.5-Reactive" -> "4.1-Preventive" [style=solid, color="#0683FF", penwidth=2.5];

    // Attack Step 4 Flow
    "4.1-Preventive" -> "4.2-Attack" [style=solid, color="#333333", penwidth=2.5];
    "4.2-Attack" -> "4.3-Chaos" [style=dashed, color="#FC8600", penwidth=2, label="SCE Test"];
    "4.2-Attack" -> "4.4-Detective" [style=solid, color="#333333", penwidth=2.5];
    "4.2-Attack" -> "4.5-Reactive" [style=solid, color="#333333", penwidth=2.5];

    "4.4-Detective" -> "Final" [style=solid, color="#333333", penwidth=2.5];
    "4.5-Reactive" -> "Final" [style=solid, color="#333333", penwidth=2.5];

    // ============================================================================
    // RANK ALIGNMENT
    // ============================================================================
    {rank=same; "1.1-Preventive"; "1.2-Attack"; "1.3-Chaos"}
    {rank=same; "1.4-Detective"; "1.5-Reactive"}
    {rank=same; "2.1-Preventive"; "2.2-Attack"; "2.3-Chaos"}
    {rank=same; "2.4-Detective"; "2.5-Reactive"}
    {rank=same; "3.1-Preventive"; "3.2-Attack"; "3.3-Chaos"}
    {rank=same; "3.4-Detective"; "3.5-Reactive"}
    {rank=same; "4.1-Preventive"; "4.2-Attack"; "4.3-Chaos"}
    {rank=same; "4.4-Detective"; "4.5-Reactive"}
}