{
    "title": "SCE Experiment 2.11 - Detective Probe: CloudTrail and AWS Config IMDS Tampering Detection",
    "description": "Validates that CloudTrail real-time alerting and AWS Config compliance drift detection effectively detect IMDS tampering attacks. The experiment executes Attack Node 1.3 (EC2 reconnaissance via DescribeInstances) and Attack Node 2.4 (IMDS protection weakening via ModifyInstanceMetadataOptions), then verifies that CloudTrail captures both API calls within 90 seconds and AWS Config marks the instance as NON_COMPLIANT for the EC2_IMDSV2_CHECK rule.",
    "tags": [
        "sce-2-11",
        "detective",
        "cloudtrail-detection",
        "aws-config-compliance",
        "imds-tampering",
        "t1580-cloud-infrastructure-discovery",
        "t1562-001-impair-defenses",
        "pci-dss-10-2",
        "pci-dss-11-5",
        "banking-platform",
        "ec2-metadata-service"
    ],
    "steady-state-hypothesis": {
        "title": "CloudTrail and AWS Config Detect IMDS Tampering Attacks",
        "probes": [
            {
                "type": "probe",
                "name": "verify-detective-control-effectiveness",
                "tolerance": true,
                "provider": {
                    "type": "python",
                    "module": "chaosaws.ec2.2_11_detective",
                    "func": "hypothesis_verification"
                }
            }
        ]
    },
    "method": [
        {
            "type": "action",
            "name": "establish-steady-state-with-cloudtrail-and-config",
            "provider": {
                "type": "python",
                "module": "chaosaws.ec2.2_11_detective",
                "func": "steady_state"
            },
            "pauses": {
                "after": 10
            }
        },
        {
            "type": "action",
            "name": "execute-reconnaissance-and-imds-tampering-attacks",
            "provider": {
                "type": "python",
                "module": "chaosaws.ec2.2_11_detective",
                "func": "attack"
            },
            "pauses": {
                "after": 30
            }
        }
    ],
    "rollbacks": [
        {
            "type": "action",
            "name": "cleanup-cloudformation-stack-and-restore-imds",
            "provider": {
                "type": "python",
                "module": "chaosaws.ec2.2_11_detective",
                "func": "rollback"
            }
        }
    ],
    "configuration": {
        "aws_region": {
            "type": "env",
            "key": "AWS_REGION",
            "default": "us-east-1"
        }
    },
    "secrets": {
        "aws": {
            "aws_access_key_id": {
                "type": "env",
                "key": "AWS_ACCESS_KEY_ID"
            },
            "aws_secret_access_key": {
                "type": "env",
                "key": "AWS_SECRET_ACCESS_KEY"
            }
        }
    },
    "contributions": {
        "security": "high",
        "reliability": "medium",
        "scalability": "none"
    }
}