        "type": "action",
        "name": "deploy-experiment-stack-and-reactive-control-infrastructure",
        "provider": {
          "type": "python",
          "module": "chaosaws.ec2.1_3_sce_experiment_reactive",
          "func": "steady_state"
        }
      },
      {
        "type": "action",
        "name": "create-malicious-codebuild-project-with-credential-exfiltration-buildspec",
        "provider": {
          "type": "python",
          "module": "chaosaws.ec2.1_3_sce_experiment_reactive",
