{
    "title": "SCE 1.3: Detective Control for Malicious CodeBuild Project Creation",
    "description": "Validates that EventBridge detective controls successfully detect and log the creation of malicious CodeBuild projects. The experiment creates a CodeBuild project with suspicious characteristics and verifies that EventBridge rules capture the CreateProject API call, forwarding alerts to SNS and CloudWatch Logs.",
    "tags": ["detective", "codebuild", "eventbridge", "cloudwatch", "security", "sce-1.3"],
    "steady-state-hypothesis": {
        "title": "Detective control detects malicious CodeBuild project creation",
        "probes": [
