digraph AttackGraph {
    graph [
        fontname="Arial",
        splines=ortho,
        nodesep=0.5,
        ranksep=0.75,
        rankdir=TB,
        ordering="out",
        compound=true
    ];
    node [fontname="Arial"];

    "Root_Node" [label=<
        <b>Root Node: Secure Cloud-Native Banking Platform</b><br/>
        <b>Attack:</b> ec2-modify-imds-options-001<br/>
        <b>Name:</b> Weakening EC2 IMDS Protections via<br/>
        ModifyInstanceMetadataOptions<br/>
        <b>Overview:</b> Attacker with ec2:ModifyInstanceMetadataOptions<br/>
        downgrades IMDSv2 to IMDSv1 and raises hop limit on banking<br/>
        EC2 hosts running containerized API gateways, transaction<br/>
        microservices, and DB connectors, enabling credential theft<br/>
        from containers for lateral movement to PCI-scoped data.
    >, shape=rectangle, style=filled, fillcolor="#C6E8D1", fontcolor="black", margin=0.2];

    "Final_Node" [label=<
        <b>Attack Goal Achieved (STRIDE Classification)</b><br/>
        <b>Tampering:</b> IMDS configuration altered from enforced<br/>
        IMDSv2 to permissive IMDSv1 on banking EC2 instances<br/>
        <b>Information Disclosure:</b> Temporary IAM role credentials<br/>
        (AccessKeyId, SecretAccessKey, SessionToken) exfiltrated,<br/>
        enabling access to transaction databases &amp; PCI-scoped data<br/>
        <b>Elevation of Privilege:</b> Container/sidecar processes<br/>
        gain IAM role permissions for lateral movement across<br/>
        banking microservices, Secrets Manager, &amp; S3 PCI buckets
    >, shape=rectangle, style=filled, fillcolor="#C6E8D1", fontcolor="black", margin=0.2];

    // ================================================================
    // STEP 1: Enumerate Target EC2 Instance and Current IMDS Config
    // ================================================================

    "1-Preventive" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="black",
        label=<
            <b>1.1 Least-Privilege IAM &amp; Short-Lived Credentials</b><br/>
            <b>Classification: Preventive</b><br/>
            <b>Description:</b> Restrict ec2:DescribeInstances to<br/>
            authorized operations roles only via IAM permission<br/>
            boundaries and SCPs. Deny broad EC2 describe<br/>
            permissions to CodeBuild service roles, developer<br/>
            accounts, and application instance profiles.<br/>
            Enforce resource-tag conditions limiting enumeration<br/>
            scope to non-production instances. Eliminate long-lived<br/>
            access keys; mandate AWS SSO with MFA and session<br/>
            duration &lt;1 hour for all human access to banking<br/>
            infrastructure accounts.
        >, margin=0.2
    ];

    "1-Attack" [
        shape=rectangle, style=filled, fillcolor="#F40B0B", fontcolor="black",
        label=<
            <b>1.2 Enumerate Target EC2 Instance &amp; Current</b><br/>
            <b>IMDS Configuration</b><br/>
            <b>Command:</b> aws ec2 describe-instances \<br/>
            &nbsp;&nbsp;--instance-ids &lt;INSTANCE_ID&gt; \<br/>
            &nbsp;&nbsp;--query &quot;Reservations[*].Instances[*].<br/>
            &nbsp;&nbsp;{InstanceId:InstanceId,<br/>
            &nbsp;&nbsp;HttpTokens:MetadataOptions.HttpTokens,<br/>
            &nbsp;&nbsp;HttpEndpoint:MetadataOptions.HttpEndpoint,<br/>
            &nbsp;&nbsp;HopLimit:MetadataOptions.<br/>
            &nbsp;&nbsp;HttpPutResponseHopLimit,<br/>
            &nbsp;&nbsp;State:MetadataOptions.State}&quot;<br/>
            &nbsp;&nbsp;--output table<br/>
            <b>Dependencies:</b> ec2:DescribeInstances permission;<br/>
            Valid AWS credentials (access key / session token);<br/>
            Knowledge of target banking EC2 instance ID or<br/>
            ability to enumerate instances in banking VPC<br/>
            <b>Result:</b> Attacker retrieves current IMDS config of<br/>
            target banking EC2 instance hosting containerized<br/>
            transaction microservices, confirming whether IMDSv2<br/>
            is enforced (HttpTokens: required) and current<br/>
            HttpPutResponseHopLimit. Informs attacker which<br/>
            modifications are needed to weaken protections.<br/>
            <b>TTP:</b> T1580 - Cloud Infrastructure Discovery
        >, margin=0.2
    ];

    "1-Chaos" [
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", color="#FFA500", fontcolor="#000000",
        label=<
            <b>1.3 SCE Experiment: IMDS Enumeration Resilience</b><br/>
            <b>Preventive Probe:</b> Simulate an IAM principal with<br/>
            overly broad ec2:Describe* attempting to enumerate all<br/>
            EC2 instances across the banking VPC. Verify SCPs and<br/>
            permission boundaries restrict visibility to authorized<br/>
            instance subsets only. Confirm CodeBuild roles and<br/>
            application instance profiles cannot call<br/>
            ec2:DescribeInstances against production banking hosts.<br/>
            <b>Detective Probe:</b> Execute ec2:DescribeInstances from<br/>
            a test principal and verify CloudTrail captures the API<br/>
            call with full request parameters within &lt;5 minutes.<br/>
            Confirm SIEM correlation rule fires alert for unusual<br/>
            describe-instances volume or calls from non-operations<br/>
            roles. Validate GuardDuty generates reconnaissance<br/>
            finding for anomalous enumeration pattern.<br/>
            <b>Reactive Probe:</b> After detection, verify automated<br/>
            playbook triggers: temporary STS session revocation for<br/>
            the calling principal via Lambda, SNS notification to<br/>
            SOC, and IAM access advisor review initiation. Measure<br/>
            time-to-containment target: &lt;10 minutes.
        >, margin=0.2
    ];

    "1-Detective" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="black",
        label=<
            <b>1.4 CloudTrail Monitoring &amp; GuardDuty</b><br/>
            <b>Reconnaissance Detection</b><br/>
            <b>Classification: Detective</b><br/>
            <b>Description:</b> Monitor CloudTrail for<br/>
            ec2:DescribeInstances calls from principals not in the<br/>
            authorized operations team. CloudWatch Events rule<br/>
            triggers on anomalous volume or new source IPs.<br/>
            GuardDuty analyzes CloudTrail management events and<br/>
            flags unusual EC2 API enumeration patterns<br/>
            (Recon:EC2/* findings). Centralized SIEM correlates<br/>
            with banking-specific rules (e.g., queries targeting<br/>
            MetadataOptions fields from CI roles). PCI-DSS Req 10<br/>
            alignment: comprehensive audit logging.
        >, margin=0.2
    ];

    "1-Reactive" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="black",
        label=<
            <b>1.5 Automated Credential Revocation &amp; SOC Alert</b><br/>
            <b>Classification: Reactive</b><br/>
            <b>Description:</b> On detection of unauthorized<br/>
            ec2:DescribeInstances enumeration, EventBridge<br/>
            triggers Lambda to: (1) Revoke active STS sessions<br/>
            by attaching inline deny-all policy to suspicious<br/>
            principal, (2) Rotate any associated access keys,<br/>
            (3) Send priority alert to SOC with full CloudTrail<br/>
            event context, (4) Create incident ticket for<br/>
            investigation with banking data exposure assessment.<br/>
            Target response: &lt;5 minutes.
        >, margin=0.2
    ];

    // ================================================================
    // STEP 2: Modify IMDS Options to Weaken Protections
    // ================================================================

    "2-Preventive" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="black",
        label=<
            <b>1.6 SCP: Deny IMDS Downgrade &amp; Hop Limit Increase</b><br/>
            <b>Classification: Preventive</b><br/>
            <b>Description:</b> Deploy organization-wide SCPs that:<br/>
            (1) Deny ec2:ModifyInstanceMetadataOptions when<br/>
            HttpTokens=&quot;optional&quot; (prevents IMDSv2 downgrade for<br/>
            ANY principal including root), (2) Deny when<br/>
            HttpPutResponseHopLimit &gt; 1 (prevents container IMDS<br/>
            reach), (3) Deny ec2:ModifyInstanceMetadataOptions<br/>
            permission on all non-admin IAM roles (CodeBuild,<br/>
            developer, app roles). Only break-glass admin role<br/>
            with MFA + approval workflow holds this permission.<br/>
            Permission boundaries enforce this ceiling. These<br/>
            are non-bypassable guardrails for all banking accounts.
        >, margin=0.2
    ];

    "2-Attack" [
        shape=rectangle, style=filled, fillcolor="#F40B0B", fontcolor="black",
        label=<
            <b>1.7 Modify IMDS Options to Weaken Protections</b><br/>
            <b>Command:</b> aws ec2 modify-instance-metadata-options \<br/>
            &nbsp;&nbsp;--instance-id &lt;INSTANCE_ID&gt; \<br/>
            &nbsp;&nbsp;--http-tokens optional \<br/>
            &nbsp;&nbsp;--http-endpoint enabled \<br/>
            &nbsp;&nbsp;--http-put-response-hop-limit 2<br/>
            <b>Dependencies:</b> ec2:ModifyInstanceMetadataOptions<br/>
            permission; Valid AWS credentials with above<br/>
            permission; Target banking EC2 instance must be<br/>
            in running or stopped state<br/>
            <b>Result:</b> Instance IMDS config modified: HttpTokens<br/>
            set to &quot;optional&quot; (downgrade from IMDSv2 allowing<br/>
            IMDSv1 unauthenticated requests), HopLimit increased<br/>
            to 2, allowing metadata endpoint reachable from<br/>
            banking microservice containers (API gateway,<br/>
            transaction processor, DB connector) and sidecars<br/>
            beyond host network namespace. IMDS endpoint<br/>
            confirmed enabled.<br/>
            <b>TTP:</b> T1562.001 - Impair Defenses: Disable or<br/>
            Modify Tools
        >, margin=0.2
    ];

    "2-Chaos" [
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", color="#FFA500", fontcolor="#000000",
        label=<
            <b>1.8 SCE Experiment: IMDS Downgrade Prevention</b><br/>
            <b>Resilience</b><br/>
            <b>Preventive Probe:</b> From a test principal with ec2:*<br/>
            permissions, attempt ModifyInstanceMetadataOptions with<br/>
            --http-tokens optional on a banking EC2 instance.<br/>
            Verify SCP returns explicit Deny. Repeat with<br/>
            --http-put-response-hop-limit 3. Verify both fail.<br/>
            Test from CodeBuild role and instance profile to<br/>
            confirm no role can bypass the SCP.<br/>
            <b>Detective Probe:</b> Verify denied API call is logged<br/>
            in CloudTrail with errorCode=AccessDenied. Confirm<br/>
            AWS Config rule ec2-imdsv2-check evaluates instance<br/>
            as COMPLIANT (unchanged). Validate even a failed<br/>
            attempt triggers CloudWatch alarm and SIEM alert for<br/>
            attempted defense impairment. Detection latency &lt;2 min.<br/>
            <b>Reactive Probe:</b> Simulate scenario where SCP is<br/>
            temporarily removed (misconfiguration). Verify AWS<br/>
            Config detects instance as NON_COMPLIANT. Confirm<br/>
            auto-remediation Lambda reverts HttpTokens to<br/>
            &quot;required&quot; and HopLimit to 1. Verify SOC receives<br/>
            critical alert. Time-to-remediation &lt;5 minutes.
        >, margin=0.2
    ];

    "2-Detective" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="black",
        label=<
            <b>1.9 AWS Config Rule &amp; CloudTrail Alert for IMDS</b><br/>
            <b>Modification</b><br/>
            <b>Classification: Detective</b><br/>
            <b>Description:</b> (1) AWS Config ec2-imdsv2-check<br/>
            continuously evaluates all banking EC2 instances;<br/>
            any instance where HttpTokens != &quot;required&quot; flagged<br/>
            NON_COMPLIANT. Config findings delivered to Security<br/>
            Hub for PCI-DSS Req 2 compliance dashboard.<br/>
            (2) CloudWatch Events rule triggers on CloudTrail<br/>
            eventName=ModifyInstanceMetadataOptions. ANY call<br/>
            (successful or denied) generates immediate SNS<br/>
            alert to SOC. This is a high-fidelity signal: this<br/>
            API should NEVER be called in normal banking<br/>
            operations. Zero false-positive tolerance.
        >, margin=0.2
    ];

    "2-Reactive" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="black",
        label=<
            <b>1.10 Auto-Remediation &amp; Instance Quarantine</b><br/>
            <b>Classification: Reactive</b><br/>
            <b>Description:</b> (1) AWS Config auto-remediation via<br/>
            SSM Automation: on NON_COMPLIANT for ec2-imdsv2-check,<br/>
            automatically execute ModifyInstanceMetadataOptions<br/>
            to set HttpTokens=required, HopLimit=1.<br/>
            (2) Lambda revokes calling principal sessions.<br/>
            (3) If modification succeeded before remediation,<br/>
            assume compromise: move instance to quarantine SG<br/>
            (no ingress/egress except forensic collector),<br/>
            capture EBS snapshot &amp; memory dump for forensics,<br/>
            ASG launches replacement from known-good AMI,<br/>
            freeze CI/CD pipeline until root cause analysis.<br/>
            (4) Notify PCI-DSS compliance team per Req 12.10.<br/>
            Entire chain: &lt;5 minutes.
        >, margin=0.2
    ];

    // ================================================================
    // STEP 3: Exfiltrate IAM Role Credentials via Weakened IMDS
    // ================================================================

    "3-Preventive" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="black",
        label=<
            <b>2.1 Defense-in-Depth: IMDSv2 Enforcement,</b><br/>
            <b>Least-Privilege Roles &amp; Network IMDS Restriction</b><br/>
            <b>Classification: Preventive</b><br/>
            <b>Description:</b> (1) Upstream controls from Step 2<br/>
            keep IMDSv2 enforced, requiring session token for<br/>
            metadata access. If those hold, this step is<br/>
            impossible. (2) Instance profile roles for banking<br/>
            microservices scoped to minimum permissions:<br/>
            transaction processors cannot access Secrets Manager,<br/>
            S3 PCI buckets, or cross-tier resources directly.<br/>
            Distinct roles per tier (API gateway, transaction,<br/>
            DB connector). Even if credentials stolen, blast<br/>
            radius contained. (3) Host-level iptables (hardened<br/>
            AMI) restrict 169.254.169.254 to root/authorized<br/>
            processes. Container network policies (Cilium/Calico)<br/>
            deny egress to 169.254.169.254/32 from all<br/>
            application containers.
        >, margin=0.2
    ];

    "3-Attack" [
        shape=rectangle, style=filled, fillcolor="#F40B0B", fontcolor="black",
        label=<
            <b>2.2 Exfiltrate IAM Role Credentials via Weakened</b><br/>
            <b>IMDS Endpoint</b><br/>
            <b>Command:</b> curl http://169.254.169.254/latest/<br/>
            &nbsp;&nbsp;meta-data/iam/security-credentials/<br/>
            &nbsp;&nbsp;&lt;ROLE_NAME&gt;<br/>
            <b>Dependencies:</b> Network access to IMDS endpoint from<br/>
            banking microservice container, sidecar, or compromised<br/>
            process on the instance; IMDS modifications from<br/>
            Step 2 must be active (HttpTokens optional, increased<br/>
            hop limit); IAM instance profile/role must be attached<br/>
            to target banking EC2 instance<br/>
            <b>Result:</b> Attacker retrieves temporary IAM credentials<br/>
            (AccessKeyId, SecretAccessKey, SessionToken) associated<br/>
            with the banking EC2 instance IAM role. Credentials<br/>
            enable lateral movement to transaction databases,<br/>
            PCI-scoped S3 buckets, Secrets Manager DB connection<br/>
            strings, enabling data exfiltration or financial fraud.<br/>
            <b>TTP:</b> T1552.005 - Unsecured Credentials: Cloud<br/>
            Instance Metadata API
        >, margin=0.2
    ];

    "3-Chaos" [
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", color="#FFA500", fontcolor="#000000",
        label=<
            <b>2.3 SCE Experiment: IMDS Credential Exfiltration</b><br/>
            <b>Resilience</b><br/>
            <b>Preventive Probe:</b> From within a running banking<br/>
            microservice container on EC2, attempt curl to<br/>
            http://169.254.169.254/latest/meta-data/iam/<br/>
            security-credentials/. Verify: (1) IMDSv2 returns<br/>
            401 Unauthorized without session token, (2) iptables/<br/>
            Cilium network policy blocks request returning<br/>
            connection refused, (3) Even with crafted PUT for<br/>
            token, hop limit of 1 prevents container response.<br/>
            <b>Detective Probe:</b> Execute curl attempt and verify:<br/>
            (1) VPC Flow Logs capture connection attempt to<br/>
            169.254.169.254, (2) Falco/eBPF runtime monitor<br/>
            detects curl to metadata IP from container and<br/>
            generates alert, (3) GuardDuty detects credential<br/>
            use from outside instance (UnauthorizedAccess:<br/>
            IAMUser/InstanceCredentialExfiltration.OutsideAWS).<br/>
            Detection target: &lt;1 minute for runtime alert.<br/>
            <b>Reactive Probe:</b> Simulate successful credential<br/>
            exfiltration and use from external IP. Verify:<br/>
            (1) GuardDuty triggers Lambda to revoke instance role<br/>
            sessions, (2) Instance quarantined with forensic SG,<br/>
            (3) ASG launches replacement, (4) All active sessions<br/>
            invalidated via inline deny policy, (5) Transaction<br/>
            audit initiated. Time-to-contain: &lt;3 minutes.
        >, margin=0.2
    ];

    "3-Detective" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="black",
        label=<
            <b>2.4 Runtime IMDS Monitoring &amp; GuardDuty</b><br/>
            <b>Credential Exfiltration Detection</b><br/>
            <b>Classification: Detective</b><br/>
            <b>Description:</b> (1) eBPF-based runtime security<br/>
            (Falco/Cilium Tetragon) monitors all network<br/>
            connections from container processes. Any connection<br/>
            to 169.254.169.254 from a non-authorized process<br/>
            triggers immediate high-severity alert with banking<br/>
            context (instance tags, microservice name).<br/>
            (2) GuardDuty finding UnauthorizedAccess:IAMUser/<br/>
            InstanceCredentialExfiltration.OutsideAWS detects<br/>
            when EC2 role credentials are used from external IP.<br/>
            Finding routed via EventBridge to automated response<br/>
            and SOC dashboard. (3) VPC Flow Logs analyzed for<br/>
            metadata endpoint access patterns. PCI-DSS Req 10.
        >, margin=0.2
    ];

    "3-Reactive" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="black",
        label=<
            <b>2.5 Credential Revocation, Instance Quarantine</b><br/>
            <b>&amp; Forensic Response with Deployment Freeze</b><br/>
            <b>Classification: Reactive</b><br/>
            <b>Description:</b> On GuardDuty finding or Falco alert:<br/>
            (1) Lambda attaches inline deny-all to instance role<br/>
            invalidating all active sessions immediately,<br/>
            (2) Rotates credentials in associated services,<br/>
            (3) CloudTrail analysis of all API calls with<br/>
            compromised credentials for blast radius assessment.<br/>
            (4) Move instance to quarantine SG, (5) EBS snapshot<br/>
            + memory capture for forensics, (6) ASG replaces from<br/>
            known-good AMI, (7) Freeze CodeBuild/CodePipeline<br/>
            until root cause confirmed, (8) PCI-DSS compliance<br/>
            notification for potential cardholder data breach<br/>
            (Req 12.10), (9) Transaction audit for operations<br/>
            with compromised credentials against banking<br/>
            databases. Execution target: &lt;3 min from detection.
        >, margin=0.2
    ];

    // ================================================================
    // ALIGNMENT AND RANKING
    // ================================================================

    {rank=same; "1-Chaos"; "1-Attack"}
    {rank=same; "1-Detective"; "1-Reactive"}
    {rank=same; "2-Chaos"; "2-Attack"}
    {rank=same; "2-Detective"; "2-Reactive"}
    {rank=same; "3-Chaos"; "3-Attack"}
    {rank=same; "3-Detective"; "3-Reactive"}

    // ================================================================
    // MAIN FLOW
    // ================================================================

    "Root_Node" -> "1-Preventive";

    "1-Preventive" -> "1-Attack";

    "1-Attack" -> "1-Detective";
    "1-Attack" -> "1-Reactive";

    "1-Detective" -> "2-Preventive";
    "1-Reactive" -> "2-Preventive";

    "2-Preventive" -> "2-Attack";

    "2-Attack" -> "2-Detective";
    "2-Attack" -> "2-Reactive";

    "2-Detective" -> "3-Preventive";
    "2-Reactive" -> "3-Preventive";

    "3-Preventive" -> "3-Attack";

    "3-Attack" -> "3-Detective";
    "3-Attack" -> "3-Reactive";

    "3-Detective" -> "Final_Node";
    "3-Reactive" -> "Final_Node";

    // ================================================================
    // CHAOS NODE CONNECTIONS (dashed orange)
    // ================================================================

    "1-Attack" -> "1-Chaos" [style=dashed, color="#FC8600"];
    "2-Attack" -> "2-Chaos" [style=dashed, color="#FC8600"];
    "3-Attack" -> "3-Chaos" [style=dashed, color="#FC8600"];
}