digraph AttackDefenseTree {
    graph [
        fontname="Arial",
        splines=ortho,
        nodesep=0.5,
        ranksep=0.75,
        rankdir=TB,
        ordering="out",
        compound=true
    ];
    node [fontname="Arial"];

    // ============================================================================
    // ROOT NODE
    // ============================================================================
    "Root_Node" [
        label="Root: EC2 IMDS Credential Exfiltration Attack",
        shape=rectangle, style=filled, fillcolor="#C6E8D1", fontcolor="black"
    ];

    // ============================================================================
    // ATTACK STEP 1: Identify Target EC2 Instance (T1526 - Gather victim host info)
    // ============================================================================

    "1-Preventive" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white",
        label=<
            <b>1.1 Preventive: IAM Deny ec2:DescribeInstances</b><br/>
            <b>Classification: Preventive</b><br/>
            <b>Description:</b> Enforce least-privilege IAM policy<br/>
            denying ec2:DescribeInstances to non-authorized<br/>
            roles. Restrict to only roles requiring instance<br/>
            enumeration (e.g., approved automation).<br/>
            <b>Implementation:</b> Explicit deny policy on<br/>
            development/build roles.<br/>
        >, margin=0.2
    ];

    "1-Attack" [
        shape=rectangle, style=filled, fillcolor="#F40B0B", fontcolor="white",
        label=<
            <b>1.2 Attack: Identify Target EC2 Instance</b><br/>
            <b>TTP: T1526 – Gather Victim Host Information</b><br/>
            <b>Command:</b><br/>
            aws ec2 describe-instances \<br/>
            &#x2500;&#x2500;filters &quot;Name=instance-state-name,Values=running&quot; \<br/>
            &#x2500;&#x2500;query &#x27;Reservations[*].Instances[*].[InstanceId, \<br/>
            PrivateIpAddress,Tags[?Key==`Name`].Value|[0]]&#x27; \<br/>
            &#x2500;&#x2500;output table<br/>
            <b>Dependencies:</b> ec2:DescribeInstances permission;<br/>
            attacker has valid AWS credentials (compromised or<br/>
            legitimate but overprivileged).<br/>
            <b>Result:</b> Attacker enumerates running EC2 instances,<br/>
            identifying target by ID, IP, and Name tag.<br/>
        >, margin=0.2
    ];

    "1-Chaos" [
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", color="#FFA500", fontcolor="black",
        label=<
            <b>1.3 SCE Experiment: Preventive Probe</b><br/>
            <b>Test:</b> Attempt describe-instances with dev role;<br/>
            expect access denied error.<br/>
            <b>Expected Result:</b> Command fails with<br/>
            &quot;User: arn:aws:iam::ACCOUNT:role/dev is not<br/>
            authorized to perform: ec2:DescribeInstances&quot;.<br/>
            <b>Failure Indicator:</b> Command succeeds; attacker<br/>
            gains enumeration capability.<br/>
        >, margin=0.2
    ];

    "1-Detective" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white",
        label=<
            <b>1.4 Detective: CloudTrail ec2:DescribeInstances Logging</b><br/>
            <b>Classification: Detective</b><br/>
            <b>Description:</b> CloudTrail logs all API calls,<br/>
            including ec2:DescribeInstances. Monitor for<br/>
            enumeration patterns (multiple calls from single<br/>
            principal in short time window).<br/>
            <b>Implementation:</b> CloudWatch Logs Insights query<br/>
            detects &gt;10 DescribeInstances calls per 5-minute window.<br/>
        >, margin=0.2
    ];

    "1-Chaos-Detective" [
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", color="#FFA500", fontcolor="black",
        label=<
            <b>1.5 SCE Experiment: Detective Probe</b><br/>
            <b>Test:</b> Execute 15 describe-instances calls in<br/>
            rapid succession; verify CloudWatch alert triggers<br/>
            within 2 minutes.<br/>
            <b>Expected Result:</b> Alert generated with source<br/>
            principal, timestamp, and call count.<br/>
            <b>Failure Indicator:</b> No alert; detective control<br/>
            bypassed or threshold too high.<br/>
        >, margin=0.2
    ];

    "1-Reactive" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white",
        label=<
            <b>1.6 Reactive: Disable IAM Credentials &amp; Notify</b><br/>
            <b>Classification: Reactive</b><br/>
            <b>Description:</b> EventBridge rule triggers Lambda<br/>
            upon detective alert. Lambda disables all access<br/>
            keys for source principal and publishes SNS alert<br/>
            to security team with forensic context.<br/>
            <b>Implementation:</b> Automated incident response via<br/>
            EventBridge → Lambda → IAM + SNS.<br/>
        >, margin=0.2
    ];

    "1-Chaos-Reactive" [
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", color="#FFA500", fontcolor="black",
        label=<
            <b>1.7 SCE Experiment: Reactive Probe</b><br/>
            <b>Test:</b> Trigger detective alert; verify Lambda<br/>
            disables access keys within 30 seconds; confirm<br/>
            subsequent API calls fail with AccessDenied.<br/>
            <b>Expected Result:</b> Credentials revoked; attacker<br/>
            loses access.<br/>
            <b>Failure Indicator:</b> Credentials remain active;<br/>
            attacker continues enumeration.<br/>
        >, margin=0.2
    ];

    // ============================================================================
    // ATTACK STEP 2: Weaken IMDS Security Configuration (T1578.005)
    // ============================================================================

    "2-Preventive" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white",
        label=<
            <b>1.8 Preventive: IAM Deny ec2:ModifyInstanceMetadataOptions</b><br/>
            <b>Classification: Preventive</b><br/>
            <b>Description:</b> Enforce strict least-privilege<br/>
            denying ec2:ModifyInstanceMetadataOptions to all<br/>
            non-infrastructure roles. Restrict to only dedicated<br/>
            provisioning/hardening roles with MFA requirement.<br/>
            <b>Implementation:</b> Explicit deny on dev/build roles;<br/>
            allow only infra-automation role with session<br/>
            duration &lt;1 hour.<br/>
        >, margin=0.2
    ];

    "2-Attack" [
        shape=rectangle, style=filled, fillcolor="#F40B0B", fontcolor="white",
        label=<
            <b>1.9 Attack: Weaken IMDS Security Configuration</b><br/>
            <b>TTP: T1578.005 – Modify Cloud Compute Infrastructure</b><br/>
            <b>Command:</b><br/>
            aws ec2 modify-instance-metadata-options \<br/>
            &#x2500;&#x2500;instance-id &lt;INSTANCE_ID&gt; \<br/>
            &#x2500;&#x2500;http-tokens optional \<br/>
            &#x2500;&#x2500;http-endpoint enabled \<br/>
            &#x2500;&#x2500;http-put-response-hop-limit 2<br/>
            <b>Dependencies:</b> ec2:ModifyInstanceMetadataOptions<br/>
            permission; target instance exists and is accessible;<br/>
            attacker has valid AWS credentials.<br/>
            <b>Result:</b> IMDS downgraded to IMDSv1 (HttpTokens<br/>
            optional); no token authentication required.<br/>
            HttpPutResponseHopLimit increased to 2, allowing<br/>
            credentials accessible from adjacent containers/processes.<br/>
        >, margin=0.2
    ];

    "2-Chaos" [
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", color="#FFA500", fontcolor="black",
        label=<
            <b>1.10 SCE Experiment: Preventive Probe</b><br/>
            <b>Test:</b> Attempt modify-instance-metadata-options<br/>
            with build role; expect access denied.<br/>
            <b>Expected Result:</b> Command fails with<br/>
            &quot;User is not authorized to perform<br/>
            ec2:ModifyInstanceMetadataOptions&quot;.<br/>
            <b>Failure Indicator:</b> Command succeeds; IMDS<br/>
            configuration weakened on target instance.<br/>
        >, margin=0.2
    ];

    "2-Detective" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white",
        label=<
            <b>1.11 Detective: CloudTrail ec2:ModifyInstanceMetadataOptions Logging</b><br/>
            <b>Classification: Detective</b><br/>
            <b>Description:</b> CloudTrail logs all metadata option<br/>
            modifications. Alert on any unauthorized modification,<br/>
            especially downgrade to IMDSv1 or hop-limit increase.<br/>
            <b>Implementation:</b> CloudWatch Logs Insights rule:<br/>
            detect &quot;HttpTokens&quot;: &quot;optional&quot; OR<br/>
            &quot;HttpPutResponseHopLimit&quot; &gt; 1 in ModifyInstanceMetadataOptions events.<br/>
        >, margin=0.2
    ];

    "2-Chaos-Detective" [
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", color="#FFA500", fontcolor="black",
        label=<
            <b>1.12 SCE Experiment: Detective Probe</b><br/>
            <b>Test:</b> Execute modify-instance-metadata-options<br/>
            with allowed role (for testing); verify CloudWatch<br/>
            alert generated within 1 minute with full details.<br/>
            <b>Expected Result:</b> Alert includes instance ID,<br/>
            old/new HttpTokens value, caller identity.<br/>
            <b>Failure Indicator:</b> No alert; detective control<br/>
            bypassed.<br/>
        >, margin=0.2
    ];

    "2-Reactive" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white",
        label=<
            <b>1.13 Reactive: Revert IMDS Config &amp; Isolate Instance</b><br/>
            <b>Classification: Reactive</b><br/>
            <b>Description:</b> EventBridge rule triggers Lambda<br/>
            upon detection. Lambda reverts HttpTokens to<br/>
            &quot;required&quot;, sets HttpPutResponseHopLimit to 1,<br/>
            and isolates instance network (security group to<br/>
            deny-all except logging/monitoring). Triggers forensic<br/>
            capture (EBS snapshot, memory dump if available).<br/>
            <b>Implementation:</b> Automated rollback via Lambda +<br/>
            EC2 API; instance moved to quarantine security group.<br/>
        >, margin=0.2
    ];

    "2-Chaos-Reactive" [
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", color="#FFA500", fontcolor="black",
        label=<
            <b>1.14 SCE Experiment: Reactive Probe</b><br/>
            <b>Test:</b> Trigger IMDS modification; verify Lambda<br/>
            reverts config within 2 minutes; confirm new<br/>
            configuration enforces IMDSv2 (token required);<br/>
            verify instance is moved to quarantine SG.<br/>
            <b>Expected Result:</b> IMDS reverted to secure state;<br/>
            instance isolated from network.<br/>
            <b>Failure Indicator:</b> Config remains weakened;<br/>
            instance accessible; attacker proceeds to credential theft.<br/>
        >, margin=0.2
    ];

    // ============================================================================
    // ATTACK STEP 3: Exfiltrate Temporary Security Credentials (T1187, T1552.001)
    // ============================================================================

    "3-Preventive" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white",
        label=<
            <b>1.15 Preventive: Enforce IMDSv2 at Launch Template Level</b><br/>
            <b>Classification: Preventive</b><br/>
            <b>Description:</b> Configure all EC2 launch templates<br/>
            with IMDSv2 enforced (HttpTokens=required) as<br/>
            default, preventing downgrade via CloudFormation Guard.<br/>
            <b>Implementation:</b> IaC policy validates all launch<br/>
            templates; IMDSv1 disabled at infrastructure layer.<br/>
        >, margin=0.2
    ];

    "3-Attack" [
        shape=rectangle, style=filled, fillcolor="#F40B0B", fontcolor="white",
        label=<
            <b>1.16 Attack: Exfiltrate Temporary Security Credentials</b><br/>
            <b>TTP: T1187 – Forced Authentication;<br/>
            T1552.001 – Credentials in Cloud Instance Metadata</b><br/>
            <b>Command:</b><br/>
            curl http://169.254.169.254/latest/meta-data/iam/security-credentials/<br/>
            curl http://169.254.169.254/latest/meta-data/iam/security-credentials/&lt;ROLE_NAME&gt;<br/>
            <b>Dependencies:</b> IMDS weakened to IMDSv1 from Step 2;<br/>
            network access to 169.254.169.254:80 from EC2 or<br/>
            adjacent container; process execution context on target.<br/>
            <b>Result:</b> Attacker retrieves temporary AWS credentials<br/>
            (AccessKeyId, SecretAccessKey, SessionToken, Expiration)<br/>
            associated with EC2 IAM role. Credentials valid for up<br/>
            to 1 hour; enable full API access with role permissions.<br/>
        >, margin=0.2
    ];

    "3-Chaos" [
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", color="#FFA500", fontcolor="black",
        label=<
            <b>1.17 SCE Experiment: Preventive Probe</b><br/>
            <b>Test:</b> Attempt to modify launch template to<br/>
            disable IMDSv2; verify CloudFormation Guard rejects<br/>
            with policy violation.<br/>
            <b>Expected Result:</b> Deployment fails; error states<br/>
            &quot;IMDSv2 required; HttpTokens must be &#x27;required&#x27;&quot;.<br/>
            <b>Failure Indicator:</b> Template accepts IMDSv1;<br/>
            instances launch in vulnerable state.<br/>
        >, margin=0.2
    ];

    "3-Detective" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white",
        label=<
            <b>1.18 Detective: Network Monitoring &amp; Anomaly Detection</b><br/>
            <b>Classification: Detective</b><br/>
            <b>Description:</b> Monitor for unusual IMDS requests<br/>
            (169.254.169.254) from EC2 instances. Baseline: expected<br/>
            requests only during container startup. Alert on repeated<br/>
            or bulk metadata requests from application processes or<br/>
            containers not expected to access IMDS.<br/>
            <b>Implementation:</b> VPC Flow Logs + Falco kernel<br/>
            monitoring; detect curl/wget to IMDS endpoint from<br/>
            non-init processes.<br/>
        >, margin=0.2
    ];

    "3-Chaos-Detective" [
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", color="#FFA500", fontcolor="black",
        label=<
            <b>1.19 SCE Experiment: Detective Probe</b><br/>
            <b>Test:</b> From running container, execute curl to<br/>
            IMDS; verify Falco rule triggers within 5 seconds with<br/>
            alert showing process name, PID, container ID.<br/>
            <b>Expected Result:</b> Alert: &quot;Suspicious IMDS access<br/>
            from curl process in container &lt;container_id&gt;&quot;.<br/>
            <b>Failure Indicator:</b> No alert; attacker undetected<br/>
            retrieving credentials.<br/>
        >, margin=0.2
    ];

    "3-Reactive" [
        shape=rectangle, style=filled, fillcolor="#0683FF", fontcolor="white",
        label=<
            <b>1.20 Reactive: Revoke Credentials &amp; Terminate Session</b><br/>
            <b>Classification: Reactive</b><br/>
            <b>Description:</b> Upon IMDS credential theft detection,<br/>
            EventBridge triggers Lambda to immediately revoke the<br/>
            EC2 instance's IAM role session. Lambda updates the role's<br/>
            trust policy to deny new AssumeRole calls and tags all<br/>
            API calls made with exfiltrated credentials as &quot;suspicious&quot;.<br/>
            Instance terminated; forensic capture executed.<br/>
            <b>Implementation:</b> Lambda updates IAM role + terminates<br/>
            instance; captures EBS snapshot for analysis.<br/>
        >, margin=0.2
    ];

    "3-Chaos-Reactive" [
        shape=rectangle, style="filled,rounded,bold", fillcolor="#FC8600", color="#FFA500", fontcolor="black",
        label=<
            <b>1.21 SCE Experiment: Reactive Probe</b><br/>
            <b>Test:</b> Exfiltrate credentials; attempt to use them<br/>
            for AWS API call; verify call rejected with &quot;User is<br/>
            not authorized&quot; within 1 minute.<br/>
            <b>Expected Result:</b> Credentials invalidated; attacker<br/>
            cannot perform further API calls.<br/>
            <b>Failure Indicator:</b> Credentials remain valid; attacker<br/>
            gains persistent access with role permissions.<br/>
        >, margin=0.2
    ];

    // ============================================================================
    // FINAL NODE (STRIDE Classification)
    // ============================================================================
    "Final_Node" [
        label=<
            <b>Attack Goal Blocked/Mitigated</b><br/>
            <b>STRIDE Classifications:</b><br/>
            <b>• Information Disclosure:</b> Credentials exfiltrated<br/>
            (mitigated via reactive credential revocation)<br/>
            <b>• Elevation of Privilege:</b> Attacker assumes EC2 role<br/>
            permissions (mitigated via session termination)<br/>
            <b>• Tampering:</b> IMDS weakened to IMDSv1 (mitigated<br/>
            via preventive IaC policy + reactive rollback)<br/>
        >,
        shape=rectangle, style=filled, fillcolor="#C6E8D1", fontcolor="black"
    ];

    // ============================================================================
    // GRAPH STRUCTURE &amp; CONNECTIONS
    // ============================================================================

    // Step 1 connections
    {rank=same; "1-Chaos"; "1-Attack"}
    {rank=same; "1-Detective"; "1-Chaos-Detective"}
    {rank=same; "1-Reactive"; "1-Chaos-Reactive"}

    // Step 2 connections
    {rank=same; "2-Chaos"; "2-Attack"}
    {rank=same; "2-Detective"; "2-Chaos-Detective"}
    {rank=same; "2-Reactive"; "2-Chaos-Reactive"}

    // Step 3 connections
    {rank=same; "3-Chaos"; "3-Attack"}
    {rank=same; "3-Detective"; "3-Chaos-Detective"}
    {rank=same; "3-Reactive"; "3-Chaos-Reactive"}

    // Main flow: Step 1
    "Root_Node" -> "1-Preventive" [color="black", penwidth=2];
    "1-Preventive" -> "1-Attack" [color="black", penwidth=2];
    "1-Attack" -> "1-Chaos" [style=dashed, color="#FC8600", penwidth=1.5];
    "1-Attack" -> "1-Detective" [color="black", penwidth=1.5];
    "1-Detective" -> "1-Chaos-Detective" [style=dashed, color="#FC8600", penwidth=1.5];
    "1-Attack" -> "1-Reactive" [color="black", penwidth=1.5];
    "1-Reactive" -> "1-Chaos-Reactive" [style=dashed, color="#FC8600", penwidth=1.5];

    // Main flow: Step 1 to Step 2
    "1-Detective" -> "2-Preventive" [color="black", penwidth=2];
    "1-Reactive" -> "2-Preventive" [color="black", penwidth=2];

    // Main flow: Step 2
    "2-Preventive" -> "2-Attack" [color="black", penwidth=2];
    "2-Attack" -> "2-Chaos" [style=dashed, color="#FC8600", penwidth=1.5];
    "2-Attack" -> "2-Detective" [color="black", penwidth=1.5];
    "2-Detective" -> "2-Chaos-Detective" [style=dashed, color="#FC8600", penwidth=1.5];
    "2-Attack" -> "2-Reactive" [color="black", penwidth=1.5];
    "2-Reactive" -> "2-Chaos-Reactive" [style=dashed, color="#FC8600", penwidth=1.5];

    // Main flow: Step 2 to Step 3
    "2-Detective" -> "3-Preventive" [color="black", penwidth=2];
    "2-Reactive" -> "3-Preventive" [color="black", penwidth=2];

    // Main flow: Step 3
    "3-Preventive" -> "3-Attack" [color="black", penwidth=2];
    "3-Attack" -> "3-Chaos" [style=dashed, color="#FC8600", penwidth=1.5];
    "3-Attack" -> "3-Detective" [color="black", penwidth=1.5];
    "3-Detective" -> "3-Chaos-Detective" [style=dashed, color="#FC8600", penwidth=1.5];
    "3-Attack" -> "3-Reactive" [color="black", penwidth=1.5];
    "3-Reactive" -> "3-Chaos-Reactive" [style=dashed, color="#FC8600", penwidth=1.5];

    // Main flow: Step 3 to Final
    "3-Detective" -> "Final_Node" [color="black", penwidth=2];
    "3-Reactive" -> "Final_Node" [color="black", penwidth=2];

}