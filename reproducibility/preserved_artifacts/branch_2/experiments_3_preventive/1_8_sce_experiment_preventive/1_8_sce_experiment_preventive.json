{
    "title": "SCE Experiment 1.8 - Preventive Control Against Malicious Builds",
    "description": "Validates that preventive controls successfully block malicious build processes from being initiated through AWS CodeBuild. This experiment deploys an EventBridge rule with a Lambda function that monitors CodeBuild state changes and stops builds with suspicious characteristics before they can execute malicious code.",
    "tags": ["sce", "preventive", "codebuild", "security", "chaos-engineering"],
    "steady-state-hypothesis": {
        "title": "Preventive control blocks malicious builds before execution",
        "probes": [
            {
                "type": "probe",
                "name": "verify-preventive-control-blocked-build",
                "tolerance": true,
                "provider": {
                    "type": "python",
                    "module": "chaosaws.ec2.1_8_sce_experiment_preventive",
                    "func": "hypothesis_verification"
                }
            }
        ]
    },
    "method": [
        {
            "type": "action",
            "name": "deploy-codebuild-with-preventive-controls",
            "provider": {
                "type": "python",
                "module": "chaosaws.ec2.1_8_sce_experiment_preventive",
                "func": "steady_state"
            }
        },
        {
            "type": "action",
            "name": "start-malicious-build",
            "provider": {
                "type": "python",
                "module": "chaosaws.ec2.1_8_sce_experiment_preventive",
                "func": "attack"
            }
        }
    ],
    "rollbacks": [
        {
            "type": "action",
            "name": "cleanup-experiment-resources",
            "provider": {
                "type": "python",
                "module": "chaosaws.ec2.1_8_sce_experiment_preventive",
                "func": "rollback"
            }
        }
    ]
}