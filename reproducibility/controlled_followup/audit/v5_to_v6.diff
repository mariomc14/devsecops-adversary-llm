+# ---------------------------------------------------------------------------
+# v6 tests
+# ---------------------------------------------------------------------------
+_PY_BLOCK = "```python\ndef steady_state():\n    return True\n```"
+_JSON_BLOCK = '```json\n{"title": "t", "method": [{"provider": {"type": "python", "module": "x"}}]}\n```'
+
+def test_v6_standard_order_is_unchanged():
+    text = f"Intro.\n\n{_PY_BLOCK}\n\n{_JSON_BLOCK}\n"
+    assert mod.extract_generation_artifacts(text) == (mod.extract_fenced(text, ['python', 'py']), mod.extract_fenced(text, ['json']))
+
+def test_v6_json_snippet_before_python_is_not_the_manifest():
+    snippet = '```json\n"ImageId": {\n    "{{resolve:ssm:/aws/x}}": {}\n}\n```'
+    text = f"The previous template was wrong:\n\n{snippet}\n\nFixed:\n\n{_PY_BLOCK}\n\n{_JSON_BLOCK}\n"
+    py, js = mod.extract_generation_artifacts(text)
+    assert 'def steady_state' in py
+    assert mod.json.loads(js)['title'] == 't'
+    assert mod.extract_fenced(text, ['json']).startswith('"ImageId"')  # what v5 took
+
+def test_v6_falls_back_to_first_json_when_none_after_python():
+    text = f"{_JSON_BLOCK}\n\n{_PY_BLOCK}\n"
+    py, js = mod.extract_generation_artifacts(text)
+    assert js == mod.extract_fenced(text, ['json'])
+
+def test_v6_unparseable_manifest_is_rejected_not_raised():
+    bad = '"ImageId": {\n  "x": {}\n}\n'
+    js, err = mod.CampaignRunner.safe_rewrite_manifest_modules(bad, 'cvr2_test')
+    assert js == bad and 'JSONDecodeError' in err
+    good, err2 = mod.CampaignRunner.safe_rewrite_manifest_modules('{"method": [{"provider": {"type": "python", "module": "x"}}]}', 'cvr2_test')
+    assert err2 is None and 'chaosaws.ec2.cvr2_test' in good
+    runner = object.__new__(mod.CampaignRunner)
+    task = mod.read_yaml(ROOT/'tasks'/'cn1_p.yaml')
+    report = mod.CampaignRunner.technical_validate(runner, 'def steady_state():\n    pass\n', js, 'cvr2-test', 'cvr2_test', task, NETWORK)
+    assert not report['passed'] and any('JSON parse error' in e for e in report['errors'])
