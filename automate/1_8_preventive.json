{
    "title": "SCE Experiment 1.8 - Preventive Probe: Least Privilege IAM Policy Validation",
    "description": "Validates that least privilege IAM policies effectively prevent unauthorized EC2 reconnaissance (Attack Node 1.3). The experiment creates an unprivileged IAM user with explicit deny on ec2:DescribeInstances and verifies that attempts to enumerate EC2 instances and their metadata options are blocked with AccessDenied errors, ensuring no instance data is leaked.",
    "tags": [
        "sce-1-8",
        "preventive",
        "iam-least-privilege",
        "ec2-reconnaissance",
        "t1580-cloud-infrastructure-discovery",
        "pci-dss-7-1",
        "banking-platform",
        "imds-protection"
    ],
    "steady-state-hypothesis": {
        "title": "Least Privilege IAM Policy Blocks Unauthorized EC2 Reconnaissance",
        "probes": [
            {
                "type": "probe",
                "name": "verify-preventive-control-effectiveness",
                "tolerance": true,
                "provider": {
                    "type": "python",
                    "module": "chaosaws.ec2.1_8_preventive",
                    "func": "hypothesis_verification"
                }
            }
        ]
    },
    "method": [
        {
            "type": "action",
            "name": "establish-steady-state-with-test-resources",
            "provider": {
                "type": "python",
                "module": "chaosaws.ec2.1_8_preventive",
                "func": "steady_state"
            },
            "pauses": {
                "after": 5
            }
        },
        {
            "type": "action",
            "name": "execute-ec2-reconnaissance-attack-node-1-3",
            "provider": {
                "type": "python",
                "module": "chaosaws.ec2.1_8_preventive",
                "func": "attack"
            },
            "pauses": {
                "after": 2
            }
        }
    ],
    "rollbacks": [
        {
            "type": "action",
            "name": "cleanup-cloudformation-stack-and-resources",
            "provider": {
                "type": "python",
                "module": "chaosaws.ec2.1_8_preventive",
                "func": "rollback"
            }
        }
    ],
    "configuration": {
        "aws_region": {
            "type": "env",
            "key": "AWS_REGION",
            "default": "us-east-1"
        }
    },
    "secrets": {
        "aws": {
            "aws_access_key_id": {
                "type": "env",
                "key": "AWS_ACCESS_KEY_ID"
            },
            "aws_secret_access_key": {
                "type": "env",
                "key": "AWS_SECRET_ACCESS_KEY"
            }
        }
    },
    "contributions": {
        "security": "high",
        "reliability": "medium",
        "scalability": "none"
    }
}