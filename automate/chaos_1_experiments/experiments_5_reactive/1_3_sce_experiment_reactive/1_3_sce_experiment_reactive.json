{
    "title": "SCE 1.3 Reactive Control - Malicious CodeBuild Project Detection and Removal",
    "description": "This Security Chaos Engineering experiment validates that a reactive control (CloudWatch Events + Lambda) can automatically detect and delete a malicious CodeBuild project when an attacker attempts to create one. The experiment deploys a reactive infrastructure, simulates an attack by creating a malicious CodeBuild project, and verifies that the control successfully removes the threat.",
    "tags": [
        "security-chaos-engineering",
        "reactive-control",
        "codebuild",
        "cloudtrail",
        "lambda",
        "sce-1-3"
    ],
    "steady-state-hypothesis": {
        "title": "Reactive control should automatically delete malicious CodeBuild projects",
        "probes": [
            {
                "type": "probe",
                "name": "verify-malicious-codebuild-project-deleted",
                "tolerance": true,
                "provider": {
                    "type": "python",
                    "module": "chaosaws.ec2.1_3_sce_experiment_reactive",
                    "func": "hypothesis_verification"
                }
            }
        ]
    },
    "method": [
        {
            "type": "action",
            "name": "deploy-reactive-control-infrastructure",
            "provider": {
                "type": "python",
                "module": "chaosaws.ec2.1_3_sce_experiment_reactive",
                "func": "steady_state"
            }
        },
        {
            "type": "action",
            "name": "create-malicious-codebuild-project",
            "provider": {
                "type": "python",
                "module": "chaosaws.ec2.1_3_sce_experiment_reactive",
                "func": "attack"
            }
        }
    ],
    "rollbacks": [
        {
            "type": "action",
            "name": "cleanup-experiment-resources",
            "provider": {
                "type": "python",
                "module": "chaosaws.ec2.1_3_sce_experiment_reactive",
                "func": "rollback"
            }
        }
    ]
}